@model IEnumerable<StudentPortal.Models.Lecturer>

@{
    ViewData["Title"] = "Quản lý Giảng viên";
    Layout = "_AdminLayout";
}

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        transition: 0.3s;
    }

    .action-col {
        width: 150px;
        white-space: nowrap;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white font-weight-bold">Danh sách Giảng viên</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
        <i class="fas fa-user-tie mr-2"></i>Thêm mới
    </a>
</div>

<div class="card shadow mb-4" style="background-color: #1e2130; border: none;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover text-light mb-0">
                <thead style="background-color: rgba(255,255,255,0.05); border-bottom: 2px solid rgba(255,255,255,0.1);">
                    <tr>
                        <th class="py-3 border-0">Mã GV</th>
                        <th class="py-3 border-0">Họ và Tên</th>
                        <th class="py-3 border-0">Khoa</th>
                        <th class="py-3 border-0">Email</th>
                        <th class="py-3 border-0">Số điện thoại</th>
                        <th class="py-3 border-0 text-right">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td class="align-middle font-weight-bold text-info">
                                @item.User.UserName
                            </td>

                            <td class="align-middle">
                                @item.User.FullName
                            </td>

                            <td class="align-middle">
                                <span class="badge badge-secondary p-2">
                                    @(item.Faculty?.FacultyName ?? "Chưa phân công")
                                </span>
                            </td>

                            <td class="align-middle">
                                @(item.User.Email ?? "---")
                            </td>

                            <td class="align-middle">
                                @(item.User.PhoneNumber ?? "---")
                            </td>

                            <td class="align-middle text-right action-col">
                                <a asp-action="Details" asp-route-id="@item.LecturerId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Xem hồ sơ">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.LecturerId" class="btn btn-sm btn-outline-warning rounded-circle mr-1" title="Sửa">
                                    <i class="fas fa-pen"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                        data-toggle="modal" data-target="#deleteModal"
                                        onclick="setDeleteId('@item.LecturerId', '@item.User.FullName')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #2a2d3e; color: white;">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title text-danger"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa giảng viên <strong id="nameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted font-italic">Cảnh báo: Tài khoản đăng nhập của giảng viên này cũng sẽ bị xóa vĩnh viễn.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Lecturers/Delete/" + id;
        document.getElementById("nameDisplay").innerText = name;
    }
</script>