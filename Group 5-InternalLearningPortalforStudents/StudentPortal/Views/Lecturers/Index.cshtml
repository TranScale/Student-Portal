@model IEnumerable<StudentPortal.Models.Lecturer>

@{
    ViewData["Title"] = "Quản lý Giảng viên";
    Layout = "_AdminLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #fff;">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Danh sách Giảng viên</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-user-plus mr-2"></i>Thêm Giảng viên
    </a>
</div>

<div class="glass-panel">
    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Mã GV</th>
                    <th>Giảng viên</th>
                    <th>Thông tin liên hệ</th>
                    <th>Khoa / Đơn vị</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge badge-warning p-2 text-dark">@item.LecturerId</span>
                        </td>

                        <td>
                            <div class="d-flex align-items-center">
                                <div class="mini-avatar mr-2 bg-primary">
                                    @(item.User.FullName?.Substring(0, 1) ?? "G")
                                </div>
                                <div>
                                    <div class="font-weight-bold text-white">@item.User.FullName</div>
                                    <div class="small text-muted">
                                        <i class="fas fa-user-circle mr-1"></i>@item.User.UserName
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="text-white small mb-1">
                                <i class="fas fa-envelope mr-2 text-muted" style="width: 15px;"></i>@item.User.Email
                            </div>
                            <div class="text-white small">
                                <i class="fas fa-phone mr-2 text-muted" style="width: 15px;"></i>@item.User.PhoneNumber
                            </div>
                        </td>

                        <td>
                            <div class="text-white">
                                <i class="fas fa-university mr-2 text-white-50"></i>
                                @(item.Faculty?.FacultyName ?? "Chưa phân công")
                            </div>
                        </td>

                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.LecturerId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Xem hồ sơ">
                                <i class="fas fa-eye"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.LecturerId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                <i class="fas fa-pen"></i>
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                    data-toggle="modal" data-target="#deleteModal"
                                    onclick="setDeleteId('@item.LecturerId', '@item.User.FullName')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white; border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa giảng viên <strong id="deleteNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Cảnh báo: Tài khoản hệ thống của giảng viên này cũng sẽ bị xóa.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Lecturers/Delete/" + id;
        document.getElementById("deleteNameDisplay").innerText = name;
    }
</script>