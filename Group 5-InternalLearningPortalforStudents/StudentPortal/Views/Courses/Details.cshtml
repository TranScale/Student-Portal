@model StudentPortal.Models.Course

@{
    ViewData["Title"] = "Chi tiết Môn học";
    Layout = "_AdminLayout";

    var totalSections = Model.CourseSections?.Count ?? 0;
    var totalStudents = Model.CourseSections?.Sum(cs => cs.Enrollments?.Count ?? 0) ?? 0;
}

<style>
    .course-header-banner {
        height: 140px;
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border-radius: 15px 15px 0 0;
        position: relative;
        overflow: hidden;
    }

    .course-icon-large {
        position: absolute;
        right: 20px;
        bottom: -10px;
        font-size: 100px;
        color: rgba(255,255,255,0.15);
        transform: rotate(-15deg);
    }

    .mini-stat-box {
        background-color: rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Quản lý Môn học</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-warning shadow-sm px-4">
            <i class="fas fa-pen mr-2"></i>Cập nhật
        </a>
        <a asp-action="Index" class="btn btn-secondary ml-2 shadow-sm px-4">
            <i class="fas fa-arrow-left mr-2"></i>Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="glass-panel p-0 h-100">
            <div class="course-header-banner p-4 d-flex align-items-center">
                <div class="z-index-1 text-white">
                    <div class="badge badge-light text-primary font-weight-bold mb-2 px-3">@Model.CourseCode</div>
                    <h4 class="font-weight-bold mb-0 text-truncate" title="@Model.CourseName">@Model.CourseName</h4>
                </div>
                <i class="fas fa-book-open course-icon-large"></i>
            </div>

            <div class="p-4 text-white">
                <h6 class="text-uppercase text-muted mb-3 font-size-12">Thông tin đào tạo</h6>

                <ul class="list-unstyled">
                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2" style="border-color: rgba(255,255,255,0.1) !important;">
                        <span class="text-white-50"><i class="fas fa-university mr-2"></i>Khoa/Bộ môn</span>
                        <span class="font-weight-bold text-right text-info">@(Model.Department?.DepartmentName ?? "N/A")</span>
                    </li>
                    <li class="mb-3 d-flex justify-content-between border-bottom pb-2" style="border-color: rgba(255,255,255,0.1) !important;">
                        <span class="text-white-50"><i class="fas fa-layer-group mr-2"></i>Số tín chỉ</span>
                        <span class="font-weight-bold">@Model.CourseCredit</span>
                    </li>
                </ul>

                <h6 class="text-uppercase text-muted mb-3 font-size-12 mt-4">Thống kê hoạt động</h6>
                <div class="row">
                    <div class="col-12">
                        <div class="mini-stat-box">
                            <h3 class="font-weight-bold mb-0 text-warning">@totalSections</h3>
                            <small class="text-white-50">Lớp mở</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="glass-panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-white mb-0"><i class="fas fa-list-alt mr-2"></i>Danh sách Lớp học phần</h5>
                <a asp-controller="CourseSections" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-primary shadow-sm">
                    <i class="fas fa-plus mr-1"></i> Mở lớp mới
                </a>
            </div>

            <div class="table-responsive">
                <table class="table-admin">
                    <thead>
                        <tr>
                            <th>Giảng viên</th>
                            <th>Học kỳ</th>
                            <th class="text-center">Sĩ số</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CourseSections != null && Model.CourseSections.Any())
                        {
                            foreach (var item in Model.CourseSections)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <div class="text-white font-weight-bold">@(item.Lecturer?.User?.FullName ?? "Chưa phân công")</div>
                                                <small class="text-white-50">@(item.Lecturer?.User?.Email)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-dark border border-secondary">
                                            @(item.Semester?.SemesterName ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="text-center text-white font-weight-bold">
                                        @(item.Enrollments?.Count ?? 0)
                                    </td>
                                    <td class="text-right">
                                        <a asp-controller="CourseSections" asp-action="Details" asp-route-id="@item.CourseSectionId"
                                           class="btn btn-sm btn-outline-info rounded-circle" title="Xem chi tiết lớp">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fas fa-folder-open fa-3x text-muted mb-3" style="opacity: 0.3;"></i>
                                    <p class="text-white-50">Hiện chưa có lớp học phần nào được mở cho môn học này.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>