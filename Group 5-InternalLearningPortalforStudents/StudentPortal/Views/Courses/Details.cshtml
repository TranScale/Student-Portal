@model StudentPortal.Models.Course

@{
    ViewData["Title"] = "Chi tiết Môn học";
    Layout = "_AdminLayout";
}

<h2 class="text-white mb-4">Chi tiết Môn học</h2>

<div class="card shadow" style="background-color: #1e2130; border: none; color: #e0e0e0;">
    <div class="card-body">
        <h4 class="card-title text-primary">@Model.CourseName</h4>
        <hr style="background-color: rgba(255,255,255,0.1);" />

        <dl class="row">
            <dt class="col-sm-3 text-white-50">Mã môn học</dt>
            <dd class="col-sm-9 font-weight-bold">@Html.DisplayFor(model => model.CourseCode)</dd>

            <dt class="col-sm-3 text-white-50">Số tín chỉ</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CourseCredit)</dd>

            <dt class="col-sm-3 text-white-50">Khoa / Bộ môn</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Department.DepartmentName)</dd>
        </dl>

        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.CourseId" class="btn btn-warning">
                <i class="fas fa-pen mr-1"></i> Sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại</a>
        </div>
    </div>
</div>