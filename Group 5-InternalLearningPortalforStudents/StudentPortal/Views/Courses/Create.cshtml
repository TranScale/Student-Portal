@model StudentPortal.Models.Course

@{
    ViewData["Title"] = "Thêm Môn học mới";
    Layout = "_AdminLayout";
}

<h2 class="text-white mb-4">Thêm Môn học mới</h2>

<div class="card shadow" style="background-color: #1e2130; border: none;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CourseName" class="control-label text-white">Tên môn học</label>
                        <input asp-for="CourseName" class="form-control" placeholder="Ví dụ: Lập trình Web" />
                        <span asp-validation-for="CourseName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CourseCode" class="control-label text-white">Mã môn học</label>
                        <input asp-for="CourseCode" class="form-control" placeholder="Ví dụ: INT301" />
                        <span asp-validation-for="CourseCode" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CourseCredit" class="control-label text-white">Số tín chỉ</label>
                        <input asp-for="CourseCredit" class="form-control" min="1" max="10" />
                        <span asp-validation-for="CourseCredit" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DepartmentId" class="control-label text-white">Khoa / Bộ môn</label>
                        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId"></select>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}