@model IEnumerable<StudentPortal.Models.CourseSection>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Lớp học phần";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #fff;">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Danh sách Lớp học phần</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus-circle mr-2"></i>Mở lớp mới
    </a>
</div>

<div class="glass-panel">
    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Học kỳ</th>
                    <th>Môn học</th>
                    <th>Lớp / Phòng</th>
                    <th>Giảng viên</th>
                    <th>Lịch học</th>
                    <th class="text-center">Sĩ số</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge badge-info p-2 text-white">@item.Semester?.SemesterName</span>
                        </td>

                        <td>
                            <div class="font-weight-bold text-white">@item.Course?.CourseName</div>
                            <div class="small text-white-50">@item.Course?.CourseCode</div>
                        </td>

                        <td>
                            <div class="font-weight-bold"><i class="fas fa-door-open mr-1 text-muted"></i> @item.Room</div>
                        </td>

                        <td>
                            <div class="d-flex align-items-center">
                                <div class="mini-avatar mr-2 bg-primary">
                                    @(item.Lecturer?.User?.FullName?.Substring(0, 1) ?? "G")
                                </div>
                                <span>@(item.Lecturer?.User?.FullName ?? "Chưa phân công")</span>
                            </div>
                        </td>

                        <td>
                            <div class="small text-white">@item.Days</div>
                            <div class="badge badge-secondary">@item.Sessions</div>
                        </td>

                        <td class="text-center font-weight-bold text-white">
                            @item.Capacity
                        </td>

                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.CourseSectionId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.CourseSectionId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                <i class="fas fa-pen"></i>
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                    data-toggle="modal" data-target="#deleteModal"
                                    onclick="setDeleteId('@item.CourseSectionId', '@item.Course?.CourseName (@item.Room)')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white; border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận hủy lớp</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa lớp học phần: <br>
                <strong id="deleteNameDisplay" class="text-warning"></strong>?
                <br><br>
                <small class="text-muted">Cảnh báo: Danh sách sinh viên đã đăng ký vào lớp này cũng sẽ bị hủy.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/CourseSections/Delete/" + id;
        document.getElementById("deleteNameDisplay").innerText = name;
    }
</script>