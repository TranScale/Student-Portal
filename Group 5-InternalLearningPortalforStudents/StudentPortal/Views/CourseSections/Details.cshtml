@model StudentPortal.Models.CourseSection
@using StudentPortal.Models

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Lớp học";

    // Hứng dữ liệu từ Controller và ép kiểu
    var scoreList = ViewData["ScoreList"] as List<StudentPortal.Models.Score>;

    // --- LOGIC KIỂM TRA KHÓA (Details) ---
    bool isSemesterActive = Model.Semester != null && Model.Semester.IsActive;
    bool hasFinishedStudent = Model.Enrollments != null && Model.Enrollments.Any(e => e.Status == EnrollmentStatus.Finished);

    bool isLocked = isSemesterActive || hasFinishedStudent;

    string lockReason = isSemesterActive
                        ? "Học kỳ đang diễn ra (Active)"
                        : "Lớp học đã có sinh viên Hoàn thành (Finished)";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-panel">

            @if (isLocked)
            {
                <div class="alert alert-warning border-warning mb-4" role="alert" style="background-color: rgba(255, 193, 7, 0.2); color: #ffc107;">
                    <i class="fas fa-lock mr-2"></i>
                    <strong>Đã khóa chỉnh sửa:</strong> @lockReason.
                </div>
            }

            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h4 class="mb-0 text-white font-weight-bold">Thông tin lớp học</h4>
                <span class="badge badge-info p-2" style="font-size: 1rem;">@Model.Semester.SemesterName</span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="small text-white-50 text-uppercase mb-1">Môn học</div>
                    <h5 class="font-weight-bold">@Model.Course.CourseName</h5>
                    <div class="text-white-50">Mã: @Model.Course.CourseCode</div>
                </div>
                <div class="col-md-6 text-md-right">
                    <div class="small text-white-50 text-uppercase mb-1">Giảng viên</div>
                    <h5 class="font-weight-bold text-warning">@(Model.Lecturer?.User?.FullName ?? "Chưa phân công")</h5>
                    <div class="text-white-50">Khoa: @(Model.Lecturer?.Faculty?.FacultyName ?? "N/A")</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4 mb-3">
                    <div class="p-3 rounded bg-dark border border-secondary">
                        <i class="fas fa-door-open text-primary mb-2 display-6"></i>
                        <div class="small text-white-50">Phòng học</div>
                        <div class="font-weight-bold">@Model.Room</div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="p-3 rounded bg-dark border border-secondary">
                        <i class="fas fa-users text-success mb-2 display-6"></i>
                        <div class="small text-white-50">Sĩ số</div>
                        <div class="font-weight-bold">@Model.Capacity sinh viên</div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="p-3 rounded bg-dark border border-secondary">
                        <i class="fas fa-clock text-warning mb-2 display-6"></i>
                        <div class="small text-white-50">Thời gian</div>
                        <div class="font-weight-bold">@Model.Sessions (@Model.Days)</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-center">
                <div class="small text-white-50 mb-3">Thời gian đào tạo: @Model.DayStart.ToString("dd/MM/yyyy") - @Model.DayEnd.ToString("dd/MM/yyyy")</div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-info mr-2" data-toggle="modal" data-target="#viewOnlyGradeModal">
                        <i class="fas fa-list-ol"></i> Xem bảng điểm
                    </button>

                    @if (isLocked)
                    {
                        // Nút bị khóa
                        <button type="button" class="btn btn-secondary mr-2"
                                onclick="alert('CẢNH BÁO: Không thể chỉnh sửa.\nLý do: @lockReason.');">
                            <i class="fas fa-lock"></i> Đã khóa
                        </button>
                    }
                    else
                    {
                        // Nút sửa bình thường
                        <a asp-action="Edit" asp-route-id="@Model.CourseSectionId" class="btn btn-warning mr-2">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-light"><i class="fas fa-arrow-left"></i> Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="viewOnlyGradeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content glass-content" style="background: rgba(255, 255, 255, 0.98); color: #000;">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title font-weight-bold text-primary">
                    <i class="fas fa-clipboard-list"></i> Danh sách điểm sinh viên
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (scoreList == null || !scoreList.Any())
                {
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-exclamation-circle"></i> Chưa có dữ liệu điểm hoặc chưa có sinh viên trong lớp.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 5%">STT</th>
                                    <th style="width: 15%">Mã SV</th>
                                    <th style="width: 25%">Họ tên</th>
                                    <th class="text-center">Quá trình (30%)</th>
                                    <th class="text-center">Giữa kỳ (20%)</th>
                                    <th class="text-center">Cuối kỳ (50%)</th>
                                    <th class="text-center table-primary">Tổng kết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var score in scoreList)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(i++)</td>
                                        <td class="font-weight-bold text-secondary">@score.Student.StudentCode</td>
                                        <td>@score.Student.User.FullName</td>

                                        <td class="text-center">@(score.ProcessScore > 0 ? score.ProcessScore.ToString() : "-")</td>
                                        <td class="text-center">@(score.MiddleScore > 0 ? score.MiddleScore.ToString() : "-")</td>
                                        <td class="text-center">@(score.ExamScore > 0 ? score.ExamScore.ToString() : "-")</td>

                                        <td class="text-center font-weight-bold table-primary" style="color: #d63384; font-size: 1.1em;">
                                            @score.FinalScore
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-right mt-2">
                        <small class="text-muted">Tổng số: <strong>@scoreList.Count</strong> sinh viên</small>
                    </div>
                }
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>