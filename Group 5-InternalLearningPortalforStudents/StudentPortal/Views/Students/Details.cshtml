@model StudentPortal.Models.Student

@{
    ViewData["Title"] = "Hồ sơ Sinh viên";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">Hồ sơ chi tiết</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-warning"><i class="fas fa-pen mr-2"></i>Sửa hồ sơ</a>
        <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow mb-4" style="background-color: #1e2130; border: none;">
            <div class="card-body text-center">
                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px; font-size: 40px; color: white;">
                    @Model.User.FullName?.Substring(0, 1)
                </div>
                <h4 class="text-white">@Model.User.FullName</h4>
                <p class="text-muted">@Model.StudentCode</p>
                
                @if (Model.IsGraduate)
                {
                    <span class="badge badge-success px-3 py-2">Đã tốt nghiệp</span>
                }
                else
                {
                    <span class="badge badge-info px-3 py-2">Đang theo học</span>
                }
            </div>
            <ul class="list-group list-group-flush" style="background-color: transparent;">
                <li class="list-group-item d-flex justify-content-between align-items-center text-white" style="background-color: rgba(255,255,255,0.05);">
                    <span><i class="fas fa-envelope mr-2 text-warning"></i>Email</span>
                    <span class="text-muted">@Model.User.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center text-white" style="background-color: rgba(255,255,255,0.05);">
                    <span><i class="fas fa-phone mr-2 text-success"></i>SĐT</span>
                    <span class="text-muted">@(Model.User.PhoneNumber ?? "Chưa cập nhật")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center text-white" style="background-color: rgba(255,255,255,0.05);">
                    <span><i class="fas fa-birthday-cake mr-2 text-danger"></i>Ngày sinh</span>
                    <span class="text-muted">@Model.User.DateOfBirth.ToString("dd/MM/yyyy")</span>
                </li>
                 <li class="list-group-item text-white" style="background-color: rgba(255,255,255,0.05);">
                    <span><i class="fas fa-map-marker-alt mr-2 text-primary"></i>Địa chỉ</span>
                    <div class="text-muted mt-1">@(Model.User.Address ?? "Chưa cập nhật")</div>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow mb-4" style="background-color: #1e2130; border: none;">
            <div class="card-header border-bottom-0 pt-4 pb-0">
                <h5 class="text-primary border-bottom pb-2" style="border-color: rgba(255,255,255,0.1) !important;">Thông tin Đào tạo</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Ngành học:</div>
                    <div class="col-sm-8 text-white font-weight-bold">@Model.Department?.DepartmentName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Ngày nhập học:</div>
                    <div class="col-sm-8 text-white">@Model.StartStudyDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>

        <div class="card shadow" style="background-color: #1e2130; border: none;">
            <div class="card-header border-bottom-0 pt-4">
                <h5 class="text-warning">Các lớp học phần đã đăng ký</h5>
            </div>
            <div class="card-body p-0">
                <table class="table text-white mb-0">
                    <thead style="background-color: rgba(255,255,255,0.1);">
                        <tr>
                            <th>Mã môn</th>
                            <th>Tên môn học</th>
                            <th>Số tín chỉ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Enrollments != null && Model.Enrollments.Count > 0)
                        {
                            @foreach (var item in Model.Enrollments)
                            {
                                <tr>
                                    <td>@item.CourseSection.Course.CourseCode</td>
                                    <td>@item.CourseSection.Course.CourseName</td>
                                    <td>@item.CourseSection.Course.CourseCredit</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Sinh viên chưa đăng ký môn học nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>