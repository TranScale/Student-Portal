@model IEnumerable<StudentPortal.Models.Student>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
    Layout = "_AdminLayout";
}

<style>
    .table-hover tbody tr:hover {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.15) !important;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">Danh sách Sinh viên</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-user-plus mr-2"></i>Tiếp nhận SV
    </a>
</div>

<div class="card shadow mb-4" style="background-color: #1e2130; border: none;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover text-light mb-0">
                <thead style="background-color: rgba(255,255,255,0.1);">
                    <tr>
                        <th class="border-top-0">Mã SV</th>
                        <th class="border-top-0">Họ và Tên</th>
                        <th class="border-top-0">Ngành học</th>
                        <th class="border-top-0">Email</th>
                        <th class="border-top-0">Trạng thái</th>
                        <th class="border-top-0 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td class="align-middle font-weight-bold">@item.StudentCode</td>
                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <div class="ml-2">
                                        <div class="font-weight-bold">@item.User.FullName</div>
                                        <small class="text-muted">@item.User.PhoneNumber</small>
                                    </div>
                                </div>
                            </td>
                            <td class="align-middle">@item.Department.DepartmentName</td>
                            <td class="align-middle">@item.User.Email</td>
                            <td class="align-middle">
                                @if (item.IsGraduate)
                                {
                                    <span class="badge badge-success">Đã tốt nghiệp</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Đang theo học</span>
                                }
                            </td>
                            <td class="align-middle text-right">
                                <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Xem hồ sơ">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                    <i class="fas fa-pen"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                        data-toggle="modal" data-target="#deleteModal"
                                        onclick="setDeleteId('@item.StudentId', '@item.User.FullName')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white;">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa sinh viên <strong id="studentNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Cảnh báo: Tài khoản đăng nhập của sinh viên này cũng sẽ bị xóa vĩnh viễn.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Students/Delete/" + id;
        document.getElementById("studentNameDisplay").innerText = name;
    }
</script>