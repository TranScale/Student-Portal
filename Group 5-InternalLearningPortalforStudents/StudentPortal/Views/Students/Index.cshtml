@using StudentPortal.Models
@model PaginatedList<StudentPortal.Models.Student>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
    Layout = "_AdminLayout";
}

<style>
    /* CSS cho trạng thái dựa trên IsGraduate */
    .badge-status-studying {
        background-color: rgba(23, 162, 184, 0.2);
        color: #17a2b8;
        border: 1px solid rgba(23, 162, 184, 0.3);
    }

    .badge-status-graduated {
        background-color: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    /* Style cho form tìm kiếm trên nền tối */
    .filter-input {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }

        .filter-input:focus {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
            border-color: #007bff;
            box-shadow: none;
        }
        /* Màu dropdown options */
        .filter-input option {
            background-color: #1e2130;
            color: white;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #fff;">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Danh sách Sinh viên</h2>

    <div>
        <a href="/ImportData?role=student"
           class="btn btn-light text-success font-weight-bold shadow-sm mr-2">
            <i class="fas fa-file-excel mr-2"></i>Import Excel
        </a>

        <a asp-action="Create" class="btn btn-light text-primary font-weight-bold shadow-sm">
            <i class="fas fa-user-plus mr-2"></i>Thêm Sinh Viên
        </a>
    </div>
</div>

<div class="glass-panel mb-4 p-3">
    <form asp-action="Index" method="get">
        <div class="row">
            <div class="col-md-4 mb-2">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control filter-input" placeholder="Tìm tên, mã SV, email..." />
            </div>

            <div class="col-md-3 mb-2">
                <select name="departmentId" asp-items="ViewBag.Departments" class="form-control filter-input" onchange="this.form.submit()">
                    <option value="">-- Tất cả Ngành --</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="admissionYear" asp-items="ViewBag.Years" class="form-control filter-input" onchange="this.form.submit()">
                    <option value="">-- Năm nhập học --</option>
                </select>
            </div>

            <div class="col-md-3 mb-2 d-flex">
                <button type="submit" class="btn btn-primary mr-2 flex-grow-1"><i class="fas fa-search mr-1"></i> Tìm</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-sync-alt"></i></a>
            </div>
        </div>
    </form>
</div>

<div class="glass-panel">
    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Mã SV</th>
                    <th>Họ và Tên</th>
                    <th>Ngành học</th>
                    <th>Ngày nhập học</th>
                    <th>Email</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-white-50">Không tìm thấy sinh viên nào phù hợp.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge badge-info p-2">@item.StudentCode</span>
                        </td>

                        <td>
                            <div class="d-flex align-items-center">
                                <div class="mini-avatar mr-2 bg-primary">
                                    @(item.User.FullName?.Substring(0, 1) ?? "S")
                                </div>
                                <div>
                                    <div class="font-weight-bold text-white">@item.User.FullName</div>
                                    <div class="small text-white-50">@item.User.PhoneNumber</div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="font-weight-bold">@item.Department.DepartmentName</div>
                        </td>

                        <td>
                            @item.StartStudyDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            <span class="text-white-50">@item.User.Email</span>
                        </td>

                        <td class="text-center">
                            @if (item.IsGraduate)
                            {
                                <span class="badge badge-status-graduated p-2">Đã tốt nghiệp</span>
                            }
                            else
                            {
                                <span class="badge badge-status-studying p-2">Đang theo học</span>
                            }
                        </td>

                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Xem hồ sơ">
                                <i class="fas fa-eye"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                <i class="fas fa-pen"></i>
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                    data-toggle="modal" data-target="#deleteModal"
                                    onclick="setDeleteId('@item.StudentId', '@item.User.FullName')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 d-flex justify-content-between align-items-center border-top" style="border-color: rgba(255,255,255,0.1) !important;">
        <div class="text-white-50 small">
            Trang @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) / @Model.TotalPages
        </div>
        <div>
            @{
                var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                var nextDisabled = !Model.HasNextPage ? "disabled" : "";
            }

            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               asp-route-departmentId="@ViewData["CurrentDept"]"
               asp-route-admissionYear="@ViewData["CurrentYear"]"
               class="btn btn-sm btn-outline-light @prevDisabled">
                <i class="fas fa-chevron-left mr-1"></i> Trước
            </a>

            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               asp-route-departmentId="@ViewData["CurrentDept"]"
               asp-route-admissionYear="@ViewData["CurrentYear"]"
               class="btn btn-sm btn-outline-light ml-2 @nextDisabled">
                Sau <i class="fas fa-chevron-right ml-1"></i>
            </a>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white; border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa sinh viên <strong id="studentNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Cảnh báo: Tài khoản đăng nhập của sinh viên này cũng sẽ bị xóa vĩnh viễn.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Students/Delete/" + id;
        document.getElementById("studentNameDisplay").innerText = name;
    }
</script>