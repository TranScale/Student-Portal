@model StudentPortal.Models.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Thêm Sinh viên";
    Layout = "_AdminLayout";
}

<h2 class="text-white mb-4">Tiếp nhận Sinh viên mới</h2>

<div class="card shadow" style="background-color: #1e2130; border: none;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="text-primary mb-3">1. Thông tin Tài khoản & Cá nhân</h5>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="FullName" class="text-white control-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="Email" class="text-white control-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label asp-for="DateOfBirth" class="text-white control-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="PhoneNumber" class="text-white control-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="Password" class="text-white control-label">Mật khẩu khởi tạo</label>
                    <input asp-for="Password" class="form-control" placeholder="Mặc định: Student@123" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="text-white control-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>

            <hr style="background-color: rgba(255,255,255,0.1);" />

            <h5 class="text-primary mb-3">2. Thông tin Hồ sơ Học tập</h5>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="StudentCode" class="text-white control-label"></label>
                    <input asp-for="StudentCode" class="form-control" placeholder="VD: B21DCCN001" />
                    <span asp-validation-for="StudentCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="DepartmentId" class="text-white control-label"></label>
                    <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId">
                        <option value="">-- Chọn Khoa / Ngành --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success px-4"><i class="fas fa-save mr-2"></i>Lưu hồ sơ</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại</a>
            </div>
        </form>
    </div>
</div>