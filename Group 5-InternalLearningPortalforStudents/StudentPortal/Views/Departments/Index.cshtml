@model IEnumerable<StudentPortal.Models.Department>

@{
    ViewData["Title"] = "Quản lý Ngành";
    Layout = "_AdminLayout";
}

<style>
    .table-hover tbody tr:hover {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.15) !important;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">Danh sách Ngành Đào tạo</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus mr-2"></i>Thêm Ngành mới
        </a>
    }
</div>

<div class="card shadow mb-4" style="background-color: #1e2130; border: none;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover text-light mb-0">
                <thead style="background-color: rgba(255,255,255,0.1);">
                    <tr>
                        <th class="border-top-0">Mã Ngành</th>
                        <th class="border-top-0">Tên Ngành</th>
                        <th class="border-top-0">Thuộc Khoa</th>
                        <th class="border-top-0">Mô tả</th>
                        <th class="border-top-0 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td class="align-middle">
                                    <span class="badge badge-info">@item.DepartmentCode</span>
                                </td>
                                <td class="align-middle font-weight-bold">@item.DepartmentName</td>
                                <td class="align-middle">
                                    @if (item.Faculty != null)
                                    {
                                        <div>
                                            <small class="text-muted d-block">@item.Faculty.FacultyCode</small>
                                            <span>@item.Faculty.FacultyName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="fas fa-exclamation-circle"></i> Thiếu dữ liệu</span>
                                    }
                                </td>
                                <td class="align-middle text-muted">
                                    @(item.DepartmentDescription?.Length > 30 ? item.DepartmentDescription.Substring(0, 30) + "..." : item.DepartmentDescription)
                                </td>
                                <td class="align-middle text-right">
                                    <a asp-action="Details" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                                data-toggle="modal" data-target="#deleteModal"
                                                onclick="setDeleteId('@item.DepartmentId', '@item.DepartmentName')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="fas fa-box-open fa-2x mb-2 d-block"></i>
                                Chưa có dữ liệu ngành.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white;">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa ngành <strong id="deleteNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Lưu ý: Xóa ngành có thể ảnh hưởng đến các lớp học phần và sinh viên liên quan.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Departments/Delete/" + id;
        document.getElementById("deleteNameDisplay").innerText = name;
    }
</script>