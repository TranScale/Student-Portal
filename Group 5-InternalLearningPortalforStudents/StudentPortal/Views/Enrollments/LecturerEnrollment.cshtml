@using StudentPortal.Models
@{
    Layout = "_LecturerLayout";
    var availableClasses = ViewData["AvailableClasses"] as List<CourseSection> ?? new List<CourseSection>();
    var myClasses = ViewData["MyClasses"] as List<CourseSection> ?? new List<CourseSection>();
    var semesterName = ViewData["SemesterName"] as string;
    ViewData["Title"] = "Đăng ký giảng dạy";

    // Lấy trạng thái khóa
    bool isLocked = ViewData["IsLocked"] as bool? ?? false;
    string lockReason = ViewData["LockReason"] as string;
}

@* 1. Hiển thị thông báo Lỗi / Thành công *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@* --- LOGIC HIỂN THỊ TRẠNG THÁI CỔNG ĐĂNG KÝ --- *@
@if (isLocked)
{
    <div class="alert alert-warning fade show" role="alert" style="background-color: rgba(255, 193, 7, 0.15); border: 1px solid #ffc107; color: #ffc107;">
        <div class="d-flex align-items-center">
            <i class="fa fa-lock fa-2x mr-3"></i>
            <div>
                <h6 class="font-weight-bold mb-1">Cổng đăng ký giảng dạy đang đóng</h6>
                <span>
                    @if (!string.IsNullOrEmpty(lockReason))
                    {
                        @lockReason
                    }
                    else
                    {
                        @:Hiện không trong thời gian đăng ký.
                    }
                </span>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success fade show mb-4" role="alert" style="background-color: rgba(40, 167, 69, 0.15); border: 1px solid #28a745; color: #28a745;">
        <div class="d-flex align-items-center">
            <i class="fa fa-clock-o fa-2x mr-3"></i>
            <div>
                <h6 class="font-weight-bold mb-1">Cổng đăng ký đang mở (@semesterName)</h6>
                <span>Quý Thầy/Cô vui lòng chọn lớp và xác nhận sớm.</span>
            </div>
        </div>
    </div>
}

@* 2. BẢNG 1: DANH SÁCH LỚP CẦN GIẢNG VIÊN *@
<div class="col-lg-12 mb-4">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header">
                <i class="fa fa-briefcase mr-2"></i> Danh sách lớp cần Giảng viên
            </h5>

            <form method="post" asp-action="SubmitTeachingRegistration" asp-controller="Enrollments">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-reg table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 40px;"><i class="fa fa-check-square-o"></i></th>
                                <th>Mã LHP</th>
                                <th>Tên môn học</th>
                                <th>Phòng</th>
                                <th>Số TC</th>
                                <th>Sĩ số</th>
                                <th>Lịch dạy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (availableClasses.Count > 0)
                            {
                                foreach (var item in availableClasses)
                                {
                                    <tr>
                                        <td>
                                            @* Checkbox: Chỉ hiện nếu KHÔNG bị khóa *@
                                            @if (!isLocked)
                                            {
                                                <input type="checkbox" name="selectedSections" value="@item.CourseSectionId" class="big-checkbox" />
                                            }
                                            else
                                            {
                                                <span class="text-secondary" title="Đã khóa"><i class="fa fa-lock"></i></span>
                                            }
                                        </td>
                                        <td>@item.CourseSectionId</td>
                                        <td class="text-left font-weight-bold">
                                            @item.Course?.CourseName <br />
                                            <small style="color: #ffd700;">(@item.Course?.CourseCode)</small>
                                        </td>
                                        <td>@item.Room</td>
                                        <td>@item.Course?.CourseCredit</td>
                                        <td>@item.Capacity</td>
                                        <td class="text-left" style="font-size: 0.8rem;">
                                            @{
                                                string scheduleText = "";
                                                if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "Thứ 2, "; }
                                                if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "Thứ 3, "; }
                                                if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "Thứ 4, "; }
                                                if ((item.Days & ClassDays.Thursday) != 0) { scheduleText += "Thứ 5, "; }
                                                if ((item.Days & ClassDays.Friday) != 0) { scheduleText += "Thứ 6, "; }
                                                if ((item.Days & ClassDays.Saturday) != 0) { scheduleText += "Thứ 7, "; }
                                                if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                            }
                                            <i class="fa fa-clock-o text-info"></i> @scheduleText <br />
                                            <span class="text-warning">(@item.Sessions)</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        @if (isLocked)
                                        {
                                            <span class="text-warning font-weight-bold">
                                                <i class="fa fa-lock mr-2"></i> @lockReason
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Hiện không còn lớp nào trống.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Nút Submit: Chỉ hiện nếu KHÔNG bị khóa và CÓ lớp *@
                @if (!isLocked && availableClasses.Count > 0)
                {
                    <div class="mt-3 text-right">
                        <button type="submit" class="btn btn-success px-4 font-weight-bold">
                            <i class="fa fa-hand-paper-o mr-2"></i> Xác nhận nhận lớp
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@* 3. BẢNG 2: LỚP TÔI ĐANG DẠY *@
<div class="col-lg-12">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header" style="border-bottom-color: #17a2b8;">
                <i class="fa fa-calendar-check-o mr-2"></i> Lịch dạy của tôi
                <span style="font-size: 0.9rem; float: right; color: #ffd700;">
                    (Tổng: @myClasses.Count lớp)
                </span>
            </h5>

            <div class="table-responsive">
                <table class="table table-reg table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Hủy</th>
                            <th>Mã LHP</th>
                            <th>Tên môn học</th>
                            <th>Phòng</th>
                            <th>Số TC</th>
                            <th>Lịch dạy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (myClasses.Count > 0)
                        {
                            foreach (var item in myClasses)
                            {
                                <tr>
                                    <td>
                                        @* Logic Hủy: Chỉ được hủy nếu chưa khóa *@
                                        @if (!isLocked)
                                        {
                                            <form method="post" asp-action="CancelTeaching" asp-controller="Enrollments" asp-route-id="@item.CourseSectionId" onsubmit="return confirm('Thầy/Cô có chắc muốn hủy dạy lớp này không?');">
                                                <button type="submit" class="btn-delete" title="Hủy dạy">
                                                    <i class="fa fa-times-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary p-1">Đã chốt</span>
                                        }
                                    </td>
                                    <td>@item.CourseSectionId</td>
                                    <td class="text-left font-weight-bold">
                                        @item.Course?.CourseName
                                    </td>
                                    <td>@item.Room</td>
                                    <td>@item.Course?.CourseCredit</td>
                                    <td class="text-left" style="font-size: 0.8rem;">
                                        @{
                                            string scheduleText = "";
                                            if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "Thứ 2, "; }
                                            if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "Thứ 3, "; }
                                            if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "Thứ 4, "; }
                                            if ((item.Days & ClassDays.Thursday) != 0) { scheduleText += "Thứ 5, "; }
                                            if ((item.Days & ClassDays.Friday) != 0) { scheduleText += "Thứ 6, "; }
                                            if ((item.Days & ClassDays.Saturday) != 0) { scheduleText += "Thứ 7, "; }
                                            if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                        }
                                        <i class="fa fa-clock-o"></i> @scheduleText (@item.Sessions)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">Thầy/Cô chưa đăng ký dạy lớp nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card trong suốt */
    .card-transparent {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 15px;
        backdrop-filter: blur(5px);
    }

    /* Header Card */
    .reg-card-header {
        border-bottom: 2px solid #dc3545;
        padding-bottom: 10px;
        margin-bottom: 15px;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Table trong suốt */
    .table-reg th {
        background-color: rgba(255, 255, 255, 0.2);
        color: #fff;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
        font-size: 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .table-reg td {
        background-color: transparent;
        color: #fff;
        vertical-align: middle;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
    }

    .table-reg tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .text-left {
        text-align: left !important;
    }

    /* Nút xóa/hủy */
    .btn-delete {
        color: #ff6b6b;
        background: none;
        border: none;
        font-weight: bold;
        font-size: 1.2rem;
        transition: 0.2s;
    }

        .btn-delete:hover {
            color: #ff0000;
            transform: scale(1.2);
        }

    /* Checkbox */
    .big-checkbox {
        transform: scale(1.3);
        cursor: pointer;
    }

    /* Màu text phụ */
    .text-info {
        color: #17a2b8 !important;
    }

    /* Scrollbar */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 3px;
    }

    /* Utility */
    .d-flex {
        display: flex !important;
    }

    .align-items-center {
        align-items: center !important;
    }
</style>