@using StudentPortal.Models
@{
    Layout = "_LecturerLayout";
    var availableClasses = ViewData["AvailableClasses"] as List<CourseSection> ?? new List<CourseSection>();
    var myClasses = ViewData["MyClasses"] as List<CourseSection> ?? new List<CourseSection>();
    var semesterName = ViewData["SemesterName"] as string;
    ViewData["Title"] = "Đăng ký giảng dạy";

    // Lấy trạng thái khóa
    bool isLocked = ViewData["IsLocked"] as bool? ?? false;
    string lockReason = ViewData["LockReason"] as string;
}

<div class="container-fluid fade-in-up">
    @* 1. Header & Thông báo *@
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="text-white font-weight-bold text-uppercase" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
                <i class="fa fa-university text-warning mr-2"></i> Đăng ký giảng dạy
            </h2>
            <p class="text-white-50 mb-0">Học kỳ: <span class="text-white">@semesterName</span></p>
        </div>
        <div class="col-md-6 text-right">
            @if (isLocked)
            {
                <div class="status-badge status-locked">
                    <i class="fa fa-lock mr-2"></i> Cổng đóng: @(string.IsNullOrEmpty(lockReason) ? "Hết hạn đăng ký" : lockReason)
                </div>
            }
            else
            {
                <div class="status-badge status-open">
                    <i class="fa fa-check-circle mr-2"></i> Cổng đang mở
                </div>
            }
        </div>
    </div>

    @* Thông báo TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-glass-success alert-dismissible fade show mb-3" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-glass-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["Error"]
            <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @* 2. Bộ lọc tìm kiếm *@
    @if (!isLocked)
    {
        <div class="card glass-card mb-4">
            <div class="card-body p-3">
                <form method="get" action="@Url.Action("LecturerEnrollment")">
                    <div class="form-row align-items-end">
                        <div class="col-md-3 mb-2">
                            <label class="text-white-50 small font-weight-bold text-uppercase">Từ khóa</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text glass-input-icon"><i class="fa fa-search"></i></span>
                                </div>
                                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control glass-input" placeholder="Tên môn / Mã HP...">
                            </div>
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="text-white-50 small font-weight-bold text-uppercase">Khoa</label>
                            <select name="facultyId" class="form-control glass-input" onchange="this.form.submit()">
                                <option value="">-- Tất cả Khoa --</option>
                                @foreach (var item in (SelectList)ViewData["Faculties"])
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewData["CurrentFaculty"]?.ToString())">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="text-white-50 small font-weight-bold text-uppercase">Bộ môn</label>
                            <select name="departmentId" class="form-control glass-input">
                                <option value="">-- Tất cả Bộ môn --</option>
                                @foreach (var item in (SelectList)ViewData["Departments"])
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewData["CurrentDept"]?.ToString())">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-2 d-flex">
                            <button type="submit" class="btn btn-primary flex-fill mr-2 glow-on-hover"><i class="fa fa-filter"></i> Lọc</button>
                            <a href="@Url.Action("LecturerEnrollment")" class="btn btn-outline-light" title="Làm mới"><i class="fa fa-refresh"></i></a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @* 3. Danh sách lớp Available *@
    <div class="card glass-card mb-4">
        <div class="card-header border-0 pb-0">
            <h5 class="text-white font-weight-bold">
                <i class="fa fa-briefcase text-info mr-2"></i> Lớp cần Giảng viên
            </h5>
            <hr class="bg-white-50 mt-2 mb-3" />
        </div>
        <div class="card-body pt-0">
            <form method="post" asp-action="SubmitTeachingRegistration" asp-controller="Enrollments">
                <div class="table-container custom-scrollbar">
                    <table class="table table-hover table-dark-glass">
                        <thead>
                            <tr>
                                <th class="text-center" width="50">
                                    <i class="fa fa-check-square-o"></i>
                                </th>
                                <th width="100">Mã LHP</th>
                                <th>Môn học</th>
                                <th width="100" class="text-center">Phòng</th>
                                <th width="80" class="text-center">TC</th>
                                <th width="80" class="text-center">Sĩ số</th>
                                <th>Thời khóa biểu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (availableClasses.Count > 0)
                            {
                                foreach (var item in availableClasses)
                                {
                                    <tr>
                                        <td class="text-center align-middle">
                                            @if (!isLocked)
                                            {
                                                <label class="custom-check">
                                                    <input type="checkbox" name="selectedSections" value="@item.CourseSectionId">
                                                    <span class="checkmark"></span>
                                                </label>
                                            }
                                            else
                                            {
                                                <i class="fa fa-lock text-muted"></i>
                                            }
                                        </td>
                                        <td class="align-middle font-weight-bold text-monospace text-warning">@item.CourseSectionId</td>
                                        <td class="align-middle">
                                            <div class="font-weight-bold">@item.Course?.CourseName</div>
                                            <small class="text-white-50">@item.Course?.CourseCode</small>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge badge-glass-info">@item.Room</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge badge-pill badge-secondary">@item.Course?.CourseCredit</span>
                                        </td>
                                        <td class="align-middle text-center">@item.Capacity</td>
                                        <td class="align-middle">
                                            @{
                                                string scheduleText = "";
                                                if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "T2, "; }
                                                if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "T3, "; }
                                                if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "T4, "; }
                                                if ((item.Days & ClassDays.Thursday) != 0) { scheduleText += "T5, "; }
                                                if ((item.Days & ClassDays.Friday) != 0) { scheduleText += "T6, "; }
                                                if ((item.Days & ClassDays.Saturday) != 0) { scheduleText += "T7, "; }
                                                if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                            }
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-clock-o text-warning mr-2"></i>
                                                <div>
                                                    <span>@scheduleText</span>
                                                    <br />
                                                    <small class="text-white-50">(@item.Sessions tiết)</small>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="text-white-50">
                                            <i class="fa fa-inbox fa-3x mb-3"></i><br />
                                            @if (isLocked)
                                            {
                                                <span>@lockReason</span>
                                            }
                                            else
                                            {

                                                <span>Hiện không còn lớp trống.</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!isLocked && availableClasses.Count > 0)
                {
                    <div class="mt-3 text-right">
                        <button type="submit" class="btn btn-success btn-lg px-5 font-weight-bold shadow-lg glow-on-hover">
                            <i class="fa fa-hand-paper-o mr-2"></i> XÁC NHẬN NHẬN LỚP
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>

    @* 4. Lịch dạy của tôi *@
    <div class="card glass-card border-top-info">
        <div class="card-header border-0 pb-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="text-white font-weight-bold mb-0">
                    <i class="fa fa-calendar-check-o text-success mr-2"></i> Lịch dạy của tôi
                </h5>
                <span class="badge badge-glass-success px-3 py-2">Đã nhận: @myClasses.Count lớp</span>
            </div>
            <hr class="bg-white-50 mt-3 mb-3" />
        </div>
        <div class="card-body pt-0">
            <div class="table-responsive">
                <table class="table table-hover table-dark-glass">
                    <thead>
                        <tr>
                            <th width="60" class="text-center">Hủy</th>
                            <th width="100">Mã LHP</th>
                            <th>Môn học</th>
                            <th width="100" class="text-center">Phòng</th>
                            <th width="80" class="text-center">TC</th>
                            <th>Thời khóa biểu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (myClasses.Count > 0)
                        {
                            foreach (var item in myClasses)
                            {
                                <tr>
                                    <td class="text-center align-middle">
                                        @if (!isLocked)
                                        {
                                            <form method="post" asp-action="CancelTeaching" asp-controller="Enrollments" asp-route-id="@item.CourseSectionId" onsubmit="return confirm('Xác nhận HỦY dạy lớp @item.CourseSectionId?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Hủy dạy">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <i class="fa fa-check text-success" title="Đã chốt"></i>
                                        }
                                    </td>
                                    <td class="align-middle font-weight-bold text-monospace text-success">@item.CourseSectionId</td>
                                    <td class="align-middle">
                                        <div class="font-weight-bold">@item.Course?.CourseName</div>
                                    </td>
                                    <td class="align-middle text-center">
                                        <span class="badge badge-glass-info">@item.Room</span>
                                    </td>
                                    <td class="align-middle text-center">@item.Course?.CourseCredit</td>
                                    <td class="align-middle">
                                        @{
                                            string scheduleText = "";
                                            if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "T2, "; }
                                            if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "T3, "; }
                                            if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "T4, "; }
                                            if ((item.Days & ClassDays.Thursday) != 0) { scheduleText += "T5, "; }
                                            if ((item.Days & ClassDays.Friday) != 0) { scheduleText += "T6, "; }
                                            if ((item.Days & ClassDays.Saturday) != 0) { scheduleText += "T7, "; }
                                            if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                        }
                                        <i class="fa fa-clock-o text-success mr-1"></i> @scheduleText (@item.Sessions tiết)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-white-50 py-4">Chưa có lớp nào được đăng ký.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* 5. STYLES CSS CAO CẤP *@
<style>
    /* Tổng thể */
    .fade-in-up {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Glassmorphism Cards */
    .glass-card {
        background: rgba(20, 20, 30, 0.6); /* Nền tối mờ */
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .border-top-info {
        border-top: 3px solid #17a2b8 !important;
    }

    /* Inputs & Selects */
    .glass-input {
        background: rgba(0, 0, 0, 0.3) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        border-radius: 6px;
        height: calc(2.25rem + 8px);
    }

        .glass-input:focus {
            background: rgba(0, 0, 0, 0.5) !important;
            border-color: #007bff !important;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .glass-input-icon {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #aaa;
    }

    /* Custom Checkbox */
    .custom-check {
        position: relative;
        display: inline-block;
        width: 22px;
        height: 22px;
        cursor: pointer;
    }

        .custom-check input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .checkmark {
        position: absolute;
        top: 0;
        left: 0;
        height: 22px;
        width: 22px;
        background-color: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
        transition: 0.2s;
    }

    .custom-check:hover input ~ .checkmark {
        background-color: rgba(255,255,255,0.2);
    }

    .custom-check input:checked ~ .checkmark {
        background-color: #28a745;
        border-color: #28a745;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 7px;
        top: 3px;
        width: 6px;
        height: 12px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .custom-check input:checked ~ .checkmark:after {
        display: block;
    }

    /* Tables */
    .table-container {
        max-height: 450px;
        overflow-y: auto;
        position: relative;
    }

    .table-dark-glass {
        color: #e0e0e0;
        margin-bottom: 0;
    }

        .table-dark-glass thead th {
            background-color: rgba(0, 0, 0, 0.4);
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            position: sticky; /* Sticky Header */
            top: 0;
            z-index: 2;
            box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(5px);
        }

        .table-dark-glass td {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }

    /* Badges & Alerts */
    .status-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .status-locked {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .status-open {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .badge-glass-info {
        background: rgba(23, 162, 184, 0.2);
        color: #17a2b8;
        border: 1px solid rgba(23, 162, 184, 0.3);
        padding: 6px 10px;
        border-radius: 4px;
    }

    .badge-glass-success {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .alert-glass-success {
        background: rgba(40, 167, 69, 0.2);
        border: 1px solid #28a745;
        color: #8ceebb;
    }

    .alert-glass-danger {
        background: rgba(220, 53, 69, 0.2);
        border: 1px solid #dc3545;
        color: #ffb3b9;
    }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.1);
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.4);
        }

    /* Effects */
    .glow-on-hover:hover {
        box-shadow: 0 0 15px rgba(40, 167, 69, 0.5);
    }
</style>