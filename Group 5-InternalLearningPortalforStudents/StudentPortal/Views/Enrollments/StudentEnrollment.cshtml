@using StudentPortal.Models
@{
    Layout = "_StudentLayout"; // Layout của sinh viên
    ViewData["Title"] = "Đăng ký môn học";

    // Ép kiểu dữ liệu an toàn
    var availableList = ViewData["AvailableList"] as List<CourseSection> ?? new List<CourseSection>();
    var registeredList = ViewData["RegisteredList"] as List<Enrollment> ?? new List<Enrollment>();
    var semesterName = ViewData["SemesterName"] as string;

    // Lấy trạng thái khóa
    bool isLocked = ViewData["IsLocked"] as bool? ?? false;
    string lockReason = ViewData["LockReason"] as string;
}

@* 1. Hiển thị thông báo Lỗi / Thành công *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

@* --- TRẠNG THÁI CỔNG ĐĂNG KÝ --- *@
@if (isLocked)
{
    <div class="alert alert-warning fade show" role="alert" style="background-color: rgba(255, 193, 7, 0.15); border: 1px solid #ffc107; color: #ffc107;">
        <div class="d-flex align-items-center">
            <i class="fa fa-lock fa-2x mr-3"></i>
            <div>
                <h6 class="font-weight-bold mb-1">Cổng đăng ký đang đóng</h6>
                <span>@lockReason</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success fade show mb-4" role="alert" style="background-color: rgba(40, 167, 69, 0.15); border: 1px solid #28a745; color: #28a745;">
        <div class="d-flex align-items-center">
            <i class="fa fa-clock-o fa-2x mr-3"></i>
            <div>
                <h6 class="font-weight-bold mb-1">Cổng đăng ký đang mở (@semesterName)</h6>
                <span>Vui lòng chọn môn học và xác nhận đăng ký.</span>
            </div>
        </div>
    </div>
}

@* 2. BẢNG MÔN HỌC MỞ CHO ĐĂNG KÝ *@
<div class="col-lg-12 mb-4">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header">
                <i class="fa fa-book mr-2"></i> Danh sách môn học mở cho đăng ký
            </h5>

            <form method="post" asp-action="SubmitRegistration" asp-controller="Enrollments">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-reg table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 40px;"><i class="fa fa-check-square-o"></i></th>
                                <th>Mã LHP</th>
                                <th>Tên môn học</th>
                                <th>Số TC</th>
                                <th>Lớp</th>
                                <th>Sĩ số</th>
                                <th>Còn lại</th>
                                <th>Thời khóa biểu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (availableList.Count > 0)
                            {
                                foreach (var item in availableList)
                                {
                                    int remaining = item.Capacity - item.Enrollments.Count; // Sửa lại Enrollments.Count
                                                                                            <tr>
                                                                                                <td>
                                                                                                    @* Checkbox: Chỉ hiện nếu KHÔNG bị khóa *@
                                            @if (!isLocked)
                                            {
                                                <input type="checkbox" name="selectedCourses" value="@item.CourseSectionId" class="big-checkbox" />
                                            }
                                            else
                                            {
                                                <i class="fa fa-lock text-secondary"></i>
                                            }
                                        </td>
                                        <td>@item.CourseSectionId</td>
                                        <td class="text-left font-weight-bold">
                                            @item.Course?.CourseName
                                        </td>
                                        <td>@item.Course?.CourseCredit</td>
                                        <td>@item.Room</td>
                                        <td>@item.Capacity</td>
                                        <td>
                                            <span class="@(remaining > 0 ? "text-success" : "text-danger") font-weight-bold">
                                                @remaining
                                            </span>
                                        </td>
                                        <td class="text-left" style="font-size: 0.8rem;">
                                            @{
                                                string scheduleText = "";
                                                if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "Thứ 2, "; }
                                                if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "Thứ 3, "; }
                                                if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "Thứ 4, "; }
                                                if ((item.Days & ClassDays.Thursday) != 0) { scheduleText += "Thứ 5, "; }
                                                if ((item.Days & ClassDays.Friday) != 0) { scheduleText += "Thứ 6, "; }
                                                if ((item.Days & ClassDays.Saturday) != 0) { scheduleText += "Thứ 7, "; }
                                                if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                            }
                                            <i class="fa fa-clock-o text-info"></i> @scheduleText (@item.Sessions)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        @if (isLocked)
                                        {
                                            <span class="text-warning font-weight-bold"><i class="fa fa-lock"></i> @lockReason</span>
                                        }
                                        else
                                        {
                                            <span>Không tìm thấy lớp học phần nào khả dụng.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!isLocked && availableList.Count > 0)
                {
                    <div class="mt-3 text-right">
                        <button type="submit" class="btn btn-success px-4 font-weight-bold">
                            <i class="fa fa-pencil-square-o mr-2"></i> Đăng ký môn học
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@* 3. BẢNG MÔN ĐÃ ĐĂNG KÝ (LUÔN HIỆN) *@
<div class="col-lg-12">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header" style="border-bottom-color: #17a2b8;">
                <i class="fa fa-check-circle-o mr-2"></i> Môn đã đăng ký
                <span style="font-size: 0.9rem; float: right; color: #ffd700;">
                    (Tổng: @registeredList.Count môn - @registeredList.Sum(e => e.CourseSection?.Course?.CourseCredit) Tín chỉ)
                </span>
            </h5>

            <div class="table-responsive">
                <table class="table table-reg table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Trạng thái</th>
                            <th>Mã MH</th>
                            <th>Tên môn học</th>
                            <th>Nhóm</th>
                            <th>Số TC</th>
                            <th>Phòng</th>
                            <th>Thời khóa biểu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (registeredList.Count > 0)
                        {
                            foreach (var item in registeredList)
                            {
                                <tr>
                                    <td>
                                        @* Nút Hủy: Chỉ hiện nếu chưa khóa *@
                                        @if (!isLocked)
                                        {
                                            <form method="post" asp-action="CancelRegistration" asp-controller="Enrollments" asp-route-id="@item.EnrollmentId" onsubmit="return confirm('Bạn có chắc muốn hủy môn này?');">
                                                <button type="submit" class="btn-delete" title="Hủy đăng ký">
                                                    <i class="fa fa-times-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary p-1">Đã chốt</span>
                                        }
                                    </td>
                                    <td>@item.CourseSection?.Course?.CourseCode</td>
                                    <td class="text-left font-weight-bold">
                                        @item.CourseSection?.Course?.CourseName
                                    </td>
                                    <td>@item.CourseSectionId</td>
                                    <td>@item.CourseSection?.Course?.CourseCredit</td>
                                    <td>@item.CourseSection?.Room</td>
                                    <td class="text-left" style="font-size: 0.8rem;">
                                        @{
                                            var section = item.CourseSection;
                                            string scheduleText = "";
                                            if (section != null)
                                            {
                                                if ((section.Days & ClassDays.Monday) != 0) { scheduleText += "Thứ 2, "; }
                                                if ((section.Days & ClassDays.Tuesday) != 0) { scheduleText += "Thứ 3, "; }
                                                if ((section.Days & ClassDays.Wednesday) != 0) { scheduleText += "Thứ 4, "; }
                                                if ((section.Days & ClassDays.Thursday) != 0) { scheduleText += "Thứ 5, "; }
                                                if ((section.Days & ClassDays.Friday) != 0) { scheduleText += "Thứ 6, "; }
                                                if ((section.Days & ClassDays.Saturday) != 0) { scheduleText += "Thứ 7, "; }
                                                if (scheduleText.Length > 2) { scheduleText = scheduleText.Substring(0, scheduleText.Length - 2); }
                                            }
                                        }
                                        <i class="fa fa-clock-o"></i> @scheduleText
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">Bạn chưa đăng ký môn học nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* COPY STYLE CỦA GIẢNG VIÊN XUỐNG ĐÂY (NẾU CHƯA CÓ TRONG LAYOUT) *@
<style>
    /* Card trong suốt */
    .card-transparent {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 15px;
        backdrop-filter: blur(5px);
    }

    .reg-card-header {
        border-bottom: 2px solid #dc3545;
        padding-bottom: 10px;
        margin-bottom: 15px;
        color: #fff;
        font-weight: 700;
        text-transform: uppercase;
    }

    .table-reg th, .table-reg td {
        background-color: transparent;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
        vertical-align: middle;
    }

    .table-reg th {
        background-color: rgba(255, 255, 255, 0.2);
    }

    .text-left {
        text-align: left !important;
    }

    .btn-delete {
        color: #ff6b6b;
        background: none;
        border: none;
        font-size: 1.2rem;
    }

        .btn-delete:hover {
            color: #ff0000;
            transform: scale(1.2);
        }

    .big-checkbox {
        transform: scale(1.3);
        cursor: pointer;
    }

    .text-info {
        color: #17a2b8 !important;
    }
    /* Utility */
    .d-flex {
        display: flex !important;
    }

    .align-items-center {
        align-items: center !important;
    }
</style>