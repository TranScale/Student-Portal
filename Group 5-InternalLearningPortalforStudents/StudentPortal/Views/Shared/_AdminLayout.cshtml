<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/css/adminStyle.css" rel="stylesheet" />

    <style>
        .user-profile:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
        }

        .dropdown-item i {
            width: 20px;
            text-align: center;
        }

        .menu-group-header {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            padding-left: 1rem;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div class="sidebar-menu">
            <div class="menu-title">Tổng quan</div>
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-th-large"></i> <span>Dashboard</span>
            </a>

            <a asp-controller="Statistics" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="fas fa-chart-pie"></i></i> <span>Thống kê</span>
            </a>

            <div class="menu-group-header">1. Danh mục & Cấu trúc</div>

            <a asp-controller="Semesters" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Semesters" ? "active" : "")">
                <i class="fas fa-calendar-check"></i> <span>Quản lý Học kỳ</span>
            </a>

            <a asp-controller="Faculties" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Faculties" ? "active" : "")">
                <i class="fas fa-university"></i> <span>Khoa (Faculties)</span>
            </a>

            <a asp-controller="Departments" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Departments" ? "active" : "")">
                <i class="fas fa-sitemap"></i> <span>Ngành (Departments)</span>
            </a>

            <a asp-controller="Courses" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Courses" ? "active" : "")">
                <i class="fas fa-book"></i> <span>Ngân hàng Môn học</span>
            </a>

            <a asp-controller="Students" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Students" ? "active" : "")">
                <i class="fas fa-user-graduate"></i> <span>Hồ sơ Sinh viên</span>
            </a>

            <a asp-controller="Lecturers" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Lecturers" ? "active" : "")">
                <i class="fas fa-chalkboard-teacher"></i> <span>Hồ sơ Giảng viên</span>
            </a>

            <div class="menu-group-header">2. Nghiệp vụ Đào tạo</div>

            <a asp-controller="CourseSections" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CourseSections" ? "active" : "")">
                <i class="fas fa-layer-group"></i> <span>Lớp Học phần</span>
            </a>

            @* <a asp-controller="Enrollments" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Enrollments" ? "active" : "")">
                <i class="fas fa-user-check"></i> <span>Quản lý Đăng ký</span>
            </a> *@

            <div class="menu-group-header">3. Tiện ích & Hệ thống</div>

            <a asp-controller="ImportData" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ImportData" ? "active" : "")">
                <i class="fas fa-file-import"></i> <span>Import Excel</span>
            </a>

            <a asp-controller="Announcements" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Announcements" ? "active" : "")">
                <i class="fas fa-bullhorn"></i> <span>Thông báo chung</span>
            </a>

            <form class="form-inline mt-4 mb-4" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="nav-link text-danger"
                        style="background: none; border: none; cursor: pointer; width: 100%; text-align: left;"
                        onclick="localStorage.removeItem('selectedTheme');">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="ml-2">Đăng xuất</span>
                </button>
            </form>
        </div>
    </nav>

    <div class="main-content">
        <header class="topbar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Tìm kiếm sinh viên, lớp học, user...">
            </div>

            <div class="d-flex align-items-center">
                <div class="mr-4 position-relative" style="cursor: pointer">
                    <i class="fas fa-bell text-white-50" style="font-size: 1.2rem"></i>
                    <span class="position-absolute" style="top: -5px; right: -5px; width: 8px; height: 8px; background: var(--accent-red); border-radius: 50%;"></span>
                </div>

                <div class="dropdown">
                    <div class="user-profile d-flex align-items-center p-2" data-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                        <div class="text-right d-none d-md-block mr-2">
                            <div class="font-weight-bold" style="font-size: 0.9rem;">
                                @(User.Identity?.Name ?? "Admin User")
                            </div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Quản trị viên</div>
                        </div>
                        <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "Admin")&background=7b2cbf&color=fff" class="user-avatar rounded-circle" style="width: 40px; height: 40px;">
                    </div>

                    <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in">
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                            Hồ sơ cá nhân
                        </a>
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                            <i class="fas fa-key fa-sm fa-fw mr-2 text-gray-400"></i>
                            Đổi mật khẩu
                        </a>
                        <div class="dropdown-divider"></div>
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit" class="dropdown-item text-danger font-weight-bold" onclick="localStorage.removeItem('selectedTheme');">
                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2"></i>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>