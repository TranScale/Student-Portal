@using StudentPortal.Models
@{
    ViewData["Title"] = "Lịch Học";
    Layout = "_StudentLayout";

    // 1. NHẬN DỮ LIỆU TỪ CONTROLLER
    var scheduleList = ViewData["ScheduleList"] as List<ScheduleItem> ?? new List<ScheduleItem>();
    var weekRange = ViewData["WeekRange"] as string;

    // Các biến phục vụ hiển thị ngày
    var startOfWeek = ViewData["StartOfWeek"] != null ? (DateTime)ViewData["StartOfWeek"] : DateTime.Today;
    var prevDate = ViewData["PrevDate"] as string;
    var nextDate = ViewData["NextDate"] as string;

    // Các biến phục vụ Filter Dropdown
    var semesters = ViewData["Semesters"] as SelectList;
    var weeks = ViewData["Weeks"] as SelectList;
    var currentSemesterId = ViewData["CurrentSemesterId"];
    var currentDate = ViewData["CurrentDate"];
}

@functions {
    string GetColorClass(int index)
    {
        string[] colors = { "#09D1C7", "#46DFB1", "#80EE98", "#0C6478", "#213A58" };
        return colors[index % colors.Length];
    }
}

<div class="col-lg-12">
    <div class="card glass-card mb-3">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("StudentSchedule")" id="filterForm" class="row align-items-center">

                <div class="col-md-5 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-transparent text-white border-0">
                                <i class="zmdi zmdi-collection-bookmark"></i>
                            </span>
                        </div>
                        @* Khi đổi Học kỳ -> Reset ngày về null để Controller tự tính ngày đầu tiên của kỳ đó *@
                        <select name="semesterId" class="form-control custom-select-glass" onchange="document.getElementById('filterForm').submit();">
                            @foreach (var item in semesters)
                            {
                                // Logic check selected thủ công để đảm bảo chính xác
                                if (item.Value == currentSemesterId.ToString())
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-transparent text-white border-0">
                                <i class="zmdi zmdi-calendar-alt"></i>
                            </span>
                        </div>
                        @* Giữ nguyên semesterId khi chọn tuần *@
                        <select name="date" class="form-control custom-select-glass" onchange="document.getElementById('filterForm').submit();">
                            @foreach (var item in weeks)
                            {
                                if (item.Value == (currentDate?.ToString() ?? ""))
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <div class="card glass-card">
        <div class="card-body p-2">

            <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-2">
                <h5 class="card-title text-white mb-0" style="font-size: 1.2rem; font-weight: 700;">
                    <i class="zmdi zmdi-calendar-note mr-2"></i> LỊCH HỌC TẬP
                </h5>

                <div class="d-flex align-items-center">
                    @* Nút Prev/Next cần truyền cả SemesterId để không bị nhảy kỳ *@
                    <a href="@Url.Action("StudentSchedule", new { semesterId = currentSemesterId, date = prevDate })" class="nav-btn" title="Tuần trước">
                        <i class="fa fa-chevron-left"></i>
                    </a>

                    <span class="date-badge">
                        <i class="fa fa-calendar-o mr-1"></i> @weekRange
                    </span>

                    <a href="@Url.Action("StudentSchedule", new { semesterId = currentSemesterId, date = nextDate })" class="nav-btn" title="Tuần sau">
                        <i class="fa fa-chevron-right"></i>
                    </a>

                    <a href="@Url.Action("StudentSchedule", new { date = DateTime.Today.ToString("yyyy-MM-dd") })"
                       class="btn btn-sm btn-light ml-3"
                       style="font-size: 0.75rem; font-weight: bold; color: #333;">
                        Hôm nay
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-transparent">
                    <thead>
                        <tr>
                            <th scope="col" class="session-col" style="border-bottom: none;">CA</th>
                            <th scope="col">THỨ 2 <small class="header-date">@startOfWeek.ToString("dd/MM")</small></th>
                            <th scope="col">THỨ 3 <small class="header-date">@startOfWeek.AddDays(1).ToString("dd/MM")</small></th>
                            <th scope="col">THỨ 4 <small class="header-date">@startOfWeek.AddDays(2).ToString("dd/MM")</small></th>
                            <th scope="col">THỨ 5 <small class="header-date">@startOfWeek.AddDays(3).ToString("dd/MM")</small></th>
                            <th scope="col">THỨ 6 <small class="header-date">@startOfWeek.AddDays(4).ToString("dd/MM")</small></th>
                            <th scope="col">THỨ 7 <small class="header-date">@startOfWeek.AddDays(5).ToString("dd/MM")</small></th>
                            <th scope="col">CN <small class="header-date">@startOfWeek.AddDays(6).ToString("dd/MM")</small></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int session = 1; session <= 5; session++)
                        {
                            // Tính giá trị Bit tương ứng với Ca học hiện tại
                            // Ca 1 = 1, Ca 2 = 2, Ca 3 = 4, Ca 4 = 8, Ca 5 = 16
                            int currentSessionBit = 1 << (session - 1);

                            <tr>
                                <td class="session-col">
                                    <span class="session-name">@session</span>
                                    <span class="session-time">@(session == 5 ? "Tối" : (session > 2 ? "Chiều" : "Sáng"))</span>
                                </td>
                                @for (int i = 0; i < 7; i++)
                                {
                                    DateTime loopD = startOfWeek.AddDays(i);

                                    // SỬA Ở ĐÂY: Dùng phép toán AND Bitwise để kiểm tra
                                    var item = scheduleList.FirstOrDefault(s =>
                                    s.ScheduleDate.Date == loopD.Date &&
                                    ((int)s.CourseSection.Sessions & currentSessionBit) != 0
                                    );
                                    <td>
                                        @if (item != null)
                                        {
                                            <div class="event-block" style="background-color: @GetColorClass(item.CourseSectionId)"
                                                 title="GV: @(item.CourseSection?.Lecturer?.User?.FullName)">
                                                <div class="subject-title">@(item.CourseSection?.Course?.CourseName ?? "Môn học")</div>
                                                <div class="subject-info"><i class="zmdi zmdi-pin mr-1"></i> @(item.CourseSection?.Room ?? "P.Học")</div>
                                                <div class="subject-info mt-1" style="border-top: 1px solid rgba(255,255,255,0.3); padding-top: 2px;">
                                                    <i class="zmdi zmdi-account mr-1"></i>
                                                    <span style="font-size: 0.75rem;">@(item.CourseSection?.Lecturer?.User?.FullName ?? "Đang cập nhật")</span>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Style cho Dropdown trong suốt (Glass Effect) */
    .custom-select-glass {
        background-color: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        color: white !important;
        border-radius: 20px;
    }

        .custom-select-glass option {
            background-color: #333; /* Màu nền option khi xổ xuống */
            color: white;
        }

        .custom-select-glass:focus {
            background-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: none;
            border-color: rgba(255, 255, 255, 0.5);
        }

    /* Các Style cũ của bạn giữ nguyên */
    .table-transparent {
        table-layout: fixed;
        width: 100%;
    }

    .event-block {
        color: #fff;
        padding: 8px;
        border-radius: 6px;
        border-left: 4px solid rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        gap: 2px;
        white-space: normal;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.08);
        min-height: 85px;
        transition: transform 0.2s;
        cursor: pointer;
        text-shadow: 0 1px 3px rgba(0,0,0,0.4);
        font-weight: 500;
    }

        .event-block:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.2);
        }

    .subject-title {
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.2;
        margin-bottom: 2px;
    }

    .subject-info {
        font-size: 0.8rem;
        opacity: 0.95;
    }

    .nav-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none !important;
        margin: 0 5px;
    }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.4);
            transform: scale(1.1);
            color: #fff;
        }

    .date-badge {
        font-size: 0.9rem;
        color: white;
        font-weight: 600;
        margin: 0 5px;
    }

    .session-col {
        vertical-align: middle !important;
        text-align: center;
        background: rgba(255,255,255,0.1);
        color: white;
        width: 60px;
    }

    .session-name {
        display: block;
        font-size: 1.2rem;
        font-weight: bold;
    }

    .session-time {
        display: block;
        font-size: 0.7rem;
        opacity: 0.8;
    }

    th {
        text-align: center;
        color: white;
        vertical-align: middle !important;
    }

    .header-date {
        display: block;
        font-weight: normal;
        font-size: 0.8rem;
        opacity: 0.8;
        margin-top: 2px;
    }
</style>