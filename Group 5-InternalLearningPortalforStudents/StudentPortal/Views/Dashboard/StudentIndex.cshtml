@using Microsoft.AspNetCore.Identity
@using StudentPortal.Models
@using System.Globalization
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "StudentDashboard";

    // Các biến dùng cho phần Header và Form bên dưới
    var fullName = ViewData["FullName"] as string ?? "Sinh viên";
    var email = ViewData["Email"] as string;
    var phone = ViewData["Phone"] as string;
    var studentCode = ViewData["StudentCode"] as string;
    var department = ViewData["Department"] as string ?? ViewData["Deparment"] as string;
}

<div class="card mt-3">
    <div class="card-content">
        <div class="row row-group m-0">
            <div class="col-12 col-lg-6 col-xl-6 border-light">
                <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; min-height: 100px;">
                    <h4 class="mb-2 text-white font-weight-bold">Xin chào, @fullName </h4>
                    <p class="mb-0 text-white small-font" style="opacity: 0.8">
                        Chào mừng bạn quay trở lại Cổng thông tin sinh viên
                    </p>
                </div>
            </div>
            <div class="col-12 col-lg-3 col-xl-3 border-light">
                <div class="card-body">
                    <h4 class="mb-2 text-white font-weight-bold">Tổng số điểm</h4>
                    <p class="mb-0 text-white small-font" style="opacity: 0.8"></p> @ViewData["TotalScore"]
                </div>
            </div>
            <div class="col-12 col-lg-3 col-xl-3 border-light">
                <div class="card-body">
                    <h4 class="mb-2 text-white font-weight-bold">Số tín chỉ</h4>
                    <p class="mb-0 text-white small-font" style="opacity: 0.8"></p> @ViewData["TotalCredits"]
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-8 col-xl-8">

        <partial name="_CalendarPartial" />

    </div>

    <div class="col-12 col-lg-4 col-xl-4">
        <div class="card h-100" style="background-color: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
            <div class="card-body">
                <div class="card-title text-white">Thông tin cá nhân</div>
                <hr style="border-top: 1px solid rgba(255,255,255,0.1);">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form asp-controller="Dashboard" asp-action="UpdateProfileFast" method="post">
                    <div class="form-group mb-3">
                        <label for="input-1" class="text-white-50">Họ và tên</label>
                        <input type="text" name="FullName" value="@fullName"
                               class="form-control bg-transparent text-white border-white-50" id="input-1" placeholder="Điền họ và tên">
                    </div>

                    <div class="form-group mb-3">
                        <label for="input-2" class="text-white-50">Email</label>
                        <input type="email" name="Email" value="@email" readonly
                               class="form-control bg-transparent text-white border-white-50" id="input-2">
                    </div>

                    <div class="form-group mb-3">
                        <label for="input-3" class="text-white-50">Số điện thoại</label>
                        <input type="text" name="PhoneNumber" value="@phone"
                               class="form-control bg-transparent text-white border-white-50" id="input-3" placeholder="Điền số điện thoại">
                    </div>

                    <div class="form-group mb-3">
                        <label for="input-4" class="text-white-50">Mã sinh viên</label>
                        <input type="text" value="@studentCode" disabled
                               class="form-control bg-transparent text-white border-white-50" id="input-4">
                    </div>

                    <div class="form-group mb-3">
                        <label for="input-5" class="text-white-50">Ngành</label>
                        <input type="text" value="@department" disabled
                               class="form-control bg-transparent text-white border-white-50" id="input-5">
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-light px-5 w-100">
                            <i class="icon-check"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/plugins/Chart.js/Chart.min.js"></script>
    <script src="~/assets/js/index.js"></script>
}