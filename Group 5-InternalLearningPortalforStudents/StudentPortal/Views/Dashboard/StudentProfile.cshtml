@using StudentPortal.Models
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Thông tin cá nhân";
    var listCourses = ViewData["CourseList"] as List<StudentPortal.Models.Enrollment>;
}

@* --- STYLE GLASSMORPHISM (Giữ nguyên style đẹp) --- *@
<style>
    .glass-content {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .glass-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-bottom: none;
        padding: 20px;
    }

        .glass-header .close {
            color: white;
            opacity: 0.8;
            text-shadow: none;
        }

    .input-glass {
        background: #f8f9fa;
        border: 2px solid #eee;
        border-radius: 8px;
        padding: 10px 15px;
        transition: all 0.3s;
        font-weight: 500;
        color: #212529 !important;
    }

        .input-glass:focus {
            background: white;
            border-color: #764ba2;
            box-shadow: 0 0 0 3px rgba(118, 75, 162, 0.1);
            color: #000 !important;
        }

        .input-glass::placeholder {
            color: #888 !important;
            opacity: 1;
        }

        .input-glass[readonly] {
            background-color: #e9ecef;
            opacity: 1;
            border: 1px solid #ced4da;
            color: #495057 !important;
            font-weight: bold;
            cursor: not-allowed;
        }

    .avatar-box {
        width: 120px;
        height: 120px;
        background: white;
        border-radius: 50%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        position: relative;
    }

    .glass-footer {
        background-color: #fff;
        border-top: 1px solid #eee;
        padding: 15px 25px;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(118, 75, 162, 0.4);
        transition: transform 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(118, 75, 162, 0.6);
            color: white;
        }

    .nav-link {
        cursor: pointer;
    }
</style>

<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="profile-header-banner">
                    <div class="banner-content text-right p-4">
                        <h3 class="mt-5">WELCOME TO UEF</h3>
                        <p>Be who you want to be</p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-lg-2 col-md-3">
                        <div class="profile-user-avatar">
                            @* --- Avatar hiển thị chính --- *@
                            <img id="avatarPreview" src="@(string.IsNullOrEmpty(Model.User.ImagePath) ? "https://via.placeholder.com/150" : Model.User.ImagePath)"
                                 style="width:120px; height:120px; object-fit:cover; border-radius:50%; border: 3px solid #eee;" />
                        </div>
                    </div>
                    <div class="col-lg-10 col-md-9">
                        <div class="profile-user-info mt-3 mt-md-0 ml-md-3">
                            <h4 class="mb-1">@ViewData["Name"]</h4>
                            <p class="mb-0"><i class="fa fa-desktop mr-1"></i> @ViewData["Department"] &nbsp;|&nbsp; <i class="fa fa-map-marker mr-1"></i>@ViewData["City"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border-top">
                <ul class="nav nav-pills nav-pills-primary">
                    <li class="nav-item">
                        <a href="javascript:void();" class="nav-link active"><i class="icon-user"></i> Hồ sơ cá nhân</a>
                    </li>
                    <li class="nav-item">
                        <a href="javascript:void(0);" onclick="openProfileModal()" class="nav-link">
                            <i class="fa fa-pencil-square-o"></i> Cập nhật thông tin
                        </a>
                    </li>
                </ul>
                <div id="modal-placeholder"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mt-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title text-uppercase pb-2">Thông tin liên hệ</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fa fa-envelope-o mr-2"></i> <strong>Email:</strong>@ViewData["Email"]</li>
                    <li class="mb-2"><i class="fa fa-id-card-o mr-2"></i> <strong>MSSV:</strong>@ViewData["Code"]</li>
                    <li class="mb-2"><i class="fa fa-phone mr-2"></i> <strong>SĐT:</strong> @ViewData["PhoneNumber"]</li>
                </ul>
                <hr>
                <h5 class="card-title text-uppercase pb-2">Thành viên của</h5>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-university"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Trường đại học</h6>
                        <p class="mb-0 small">UEF Đại học Kinh tế - Tài chính</p>
                    </div>
                </div>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-briefcase"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Khoa</h6>
                        <p class="mb-0 small">@ViewData["Faculty"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row mt-3">
            <div class="col-12 col-lg-6">
                <div class="card text-white" style="border: 1px solid rgba(255,255,255,0.15);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-white">Điểm TB Tích lũy (Hệ 10)</p>
                                <h4 class="mb-0 text-white mt-2">@ViewData["TotalScore"]</h4>
                            </div>
                            <div class="ml-auto font-35 text-white"><i class="fa fa-graduation-cap"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card text-white" style="border: 1px solid rgba(255,255,255,0.15);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-white">Tín chỉ đã học</p>
                                <h4 class="mb-0 text-white mt-2">@ViewData["TotalCredits"]</h4>
                            </div>
                            <div class="ml-auto font-35 text-white"><i class="fa fa-book"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Danh sách các môn học</h5>

                <div class="table-responsive custom-table-scroll">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Mã học phần</th>
                                <th scope="col">Tên môn học</th>
                                <th scope="col">Số TC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listCourses != null && listCourses.Any())
                            {
                                int STT = 1;
                                foreach (var item in listCourses)
                                {
                                    <tr>
                                        <th scope="row">@(STT++)</th>
                                        <td>@item.CourseSection.Course.CourseCode</td>
                                        <td>@item.CourseSection.Course.CourseName</td>
                                        <td>@item.CourseSection.Course.CourseCredit</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Sinh viên chưa học xong môn học nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // --- PHẦN 1: LOGIC XEM TRƯỚC ẢNH (Đoạn này bị lỗi lúc nãy do chạy sớm quá) ---
        $(document).ready(function() {
            // Dùng on('change') uỷ quyền sự kiện cho document
            // Để bắt được cả phần tử sinh ra sau khi mở Modal
            $(document).on('change', '#avatarFile', function (e) {
                if (e.target.files && e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        // Tìm đúng cái ảnh trong Modal để đổi source
                        $('#avatarPreviewModal').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        });

        // --- PHẦN 2: MỞ MODAL VÀ GỬI FORM ---
        function openProfileModal() {
            $.get('/Dashboard/EditProfile', function (data) {
                $('#modal-placeholder').html(data);
                $('#profileModal').modal('show');

                $('#editProfileForm').off('submit').on('submit', function (e) {
                    e.preventDefault();
                    var form = $(this)[0];
                    var formData = new FormData(form);
                    var btn = $(this).find('button[type="submit"]');

                    btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang lưu...');

                    $.ajax({
                        url: $(this).attr('action'),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success) {
                                $('#profileModal').modal('hide');
                                location.reload();
                            } else {
                                $('#modal-placeholder').html(response);
                                btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thông tin');
                            }
                        },
                        error: function(xhr, status, error) {
                            alert("Lỗi: " + error);
                            btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thông tin');
                        }
                    });
                });
            });
        }
    </script>
}