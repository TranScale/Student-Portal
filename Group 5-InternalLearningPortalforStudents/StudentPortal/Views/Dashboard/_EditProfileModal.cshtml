@model StudentPortal.Models.Student

<div class="modal fade" id="profileModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content glass-content">

            <div class="modal-header glass-header">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-user-edit mr-2"></i> CẬP NHẬT HỒ SƠ
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="editProfileForm" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-4 text-center mb-4 border-right">
                            <div class="avatar-box mb-3">
                                @if (!string.IsNullOrEmpty(Model.User.ImagePath))
                                {
                                    <img src="@Model.User.ImagePath" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />
                                }
                                else
                                {
                                    <i class="fas fa-user fa-3x text-secondary"></i>
                                }
                            </div>
                            <h5 class="font-weight-bold text-dark mb-1">@Model.User.FullName</h5>
                            <div class="text-muted small mb-2">@Model.StudentCode</div>
                            <span class="badge badge-pill badge-primary px-3 py-2">@Model.Department?.DepartmentName</span>
                        </div>

                        <div class="col-md-8 pl-md-4">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-uppercase">Email</label>
                                        <input value="@Model.User.Email" class="form-control input-glass" readonly />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-uppercase">Số điện thoại</label>
                                        <input asp-for="User.PhoneNumber"
                                               class="form-control input-glass"
                                               placeholder="Nhập 10 số (VD: 098...)"
                                               required
                                               maxlength="10"
                                               pattern="[0]{1}[0-9]{9}"
                                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                               title="Số điện thoại phải bắt đầu bằng số 0 và có đúng 10 chữ số" />

                                        <span asp-validation-for="User.PhoneNumber" class="text-danger small font-weight-bold mt-1"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label class="font-weight-bold text-uppercase">Ngày sinh</label>
                                <input asp-for="User.DateOfBirth" type="date" class="form-control input-glass" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="font-weight-bold text-uppercase">Địa chỉ</label>
                                <input asp-for="User.Address" class="form-control input-glass" placeholder="Số nhà, đường..." />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-uppercase">Thành phố</label>
                                        <input asp-for="User.City" class="form-control input-glass" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-uppercase">Quốc gia</label>
                                        <input asp-for="User.Country" class="form-control input-glass" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="modal-footer glass-footer">
                    <button type="button" class="btn btn-light border" data-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                    <button type="submit" class="btn btn-gradient">
                        <i class="fas fa-save mr-1"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* 1. Làm đẹp khung Modal */
    .glass-content {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        overflow: hidden; /* Để bo tròn góc không bị header che mất */
    }

    /* 2. Header màu Gradient sang chảnh */
    .glass-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-bottom: none;
        padding: 20px;
    }

        .glass-header .close {
            color: white;
            opacity: 0.8;
            text-shadow: none;
        }

    /* 3. Tút lại ô Input */
    .input-glass {
        background: #f8f9fa; /* Nền xám rất nhạt */
        border: 2px solid #eee;
        border-radius: 8px;
        padding: 10px 15px;
        transition: all 0.3s;
        font-weight: 500;
        /* [QUAN TRỌNG] Ép màu chữ thành màu ĐEN */
        color: #212529 !important;
    }

        /* Màu chữ khi click vào nhập liệu */
        .input-glass:focus {
            background: white;
            border-color: #764ba2;
            box-shadow: 0 0 0 3px rgba(118, 75, 162, 0.1);
            color: #000 !important; /* Vẫn giữ màu đen khi focus */
        }

        /* [MỚI] Chỉnh màu cho dòng chữ gợi ý (Placeholder) - Ví dụ: "Nhập SĐT..." */
        .input-glass::placeholder {
            color: #888 !important; /* Màu xám đậm cho dễ đọc */
            opacity: 1; /* Hiển thị rõ, không bị mờ */
        }

        /* [MỚI] Fix lỗi trình duyệt tự đổi màu nền khi chọn autofill (lưu mật khẩu/email cũ) */
        .input-glass:-webkit-autofill,
        .input-glass:-webkit-autofill:hover,
        .input-glass:-webkit-autofill:focus {
            -webkit-text-fill-color: #000 !important; /* Ép chữ autofill thành màu đen */
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Xử lý riêng cái ô Readonly (Email) */
        .input-glass[readonly] {
            background-color: #e9ecef; /* Nền xám tối hơn 1 chút */
            opacity: 1;
            border: 1px solid #ced4da;
            color: #495057 !important; /* Màu xám đen đậm */
            font-weight: bold; /* In đậm cho dễ nhìn */
            cursor: not-allowed;
        }

    /* 4. Nhãn (Label) */
    .form-group label {
        color: #666;
        font-size: 0.85rem;
        margin-bottom: 5px;
        letter-spacing: 0.5px;
    }

    /* 5. Avatar Box */
    .avatar-box {
        width: 120px;
        height: 120px;
        background: white;
        border-radius: 50%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid #fff; /* Viền trắng */
        box-shadow: 0 5px 15px rgba(0,0,0,0.15); /* Đổ bóng nổi lên */
        position: relative;
    }

    /* 6. Footer nút bấm */
    .glass-footer {
        background-color: #fff;
        border-top: 1px solid #eee;
        padding: 15px 25px;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(118, 75, 162, 0.4);
        transition: transform 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(118, 75, 162, 0.6);
            color: white;
        }
</style>