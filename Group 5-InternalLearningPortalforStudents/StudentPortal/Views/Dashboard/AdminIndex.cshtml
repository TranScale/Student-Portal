@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Overview Dashboard</h2>
    <div class="text-white-50 small"><i class="far fa-clock"></i> Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy")</div>
</div>

<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-3">
        <div class="stat-card">
            <i class="fas fa-user-graduate stat-icon"></i>
            <span class="stat-value c-blue">@ViewData["TotalStudents"]</span>
            <span class="stat-label">Tổng Sinh viên</span>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
        <div class="stat-card">
            <i class="fas fa-chalkboard-teacher stat-icon"></i>
            <span class="stat-value c-pink">@ViewData["TotalLecturers"]</span>
            <span class="stat-label">Tổng Giảng viên</span>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
        <div class="stat-card" style="border-color: var(--accent-orange);">
            <i class="fas fa-layer-group stat-icon"></i>
            <span class="stat-value c-orange">@ViewData["TotalCourses"]</span>
            <span class="stat-label">Lớp học phần</span>
            <div class="mt-1 small text-warning font-weight-bold"><i class="fas fa-circle"></i> Đang hoạt động</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-3">
        <div class="stat-card">
            <i class="fas fa-calendar-alt stat-icon"></i>
            <span class="stat-value text-white h4 mt-2">@ViewData["CurrentSemesterName"]</span>
            <span class="stat-label">Học kỳ hiện tại</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="glass-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="panel-title mb-0">Bảng tin thông báo</div>
                <a asp-controller="Announcements" asp-action="Index" class="btn btn-sm text-white-50">Xem tất cả <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table-admin">
                    <thead>
                        <tr>
                            <th>Người đăng</th>
                            <th>Tiêu đề / Tóm tắt</th>
                            <th>Đối tượng</th>
                            <th>Ngày đăng</th>
                            <th class="text-right">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var announcements = ViewData["RecentAnnouncements"] as List<StudentPortal.Models.Announcement>;
                        }

                        @if (announcements != null && announcements.Any())
                        {
                            foreach (var item in announcements)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="mini-avatar" style="background-color: var(--accent-purple);">
                                                @(item.User != null && !string.IsNullOrEmpty(item.User.FullName) ? item.User.FullName.Substring(0, 1).ToUpper() : "A")
                                            </div>
                                            <div>
                                                <div class="font-weight-bold">@(item.User?.FullName ?? "Admin")</div>
                                                <div class="small text-white-50">Giảng viên/Admin</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-weight-bold">@item.Title</div>
                                        <div class="small text-white-50">
                                            @(item.Summary.Length > 40 ? item.Summary.Substring(0, 40) + "..." : item.Summary)
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Taker == StudentPortal.Models.RecipientType.All)
                                        {
                                            <span class="badge badge-info">Toàn trường</span>
                                        }
                                        else if (item.Taker == StudentPortal.Models.RecipientType.Student)
                                        {
                                            <span class="badge badge-success">Sinh viên</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Giảng viên</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="far fa-clock small mr-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-right">
                                        <a asp-controller="Announcements" asp-action="Details" asp-route-id="@item.AnnouncementId" class="btn btn-sm btn-primary rounded-circle" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-white-50 py-4">
                                    Chưa có thông báo nào được tạo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="glass-panel">
            <div class="panel-title">Tác vụ nhanh</div>

            <a asp-controller="ImportData" asp-action="Index" class="quick-btn">
                <div class="qb-icon" style="color:#00b894"><i class="fas fa-file-excel"></i></div>
                <div>
                    <div class="font-weight-bold">Import Dữ liệu</div>
                    <div class="small text-white-50">Nhập SV từ Excel</div>
                </div>
            </a>

            <a asp-controller="Semesters" asp-action="Index" class="quick-btn">
                <div class="qb-icon" style="color:#4cc9f0"><i class="fas fa-calendar-check"></i></div>
                <div>
                    <div class="font-weight-bold">Quản lý Học kỳ</div>
                    <div class="small text-white-50">Kích hoạt kỳ mới</div>
                </div>
            </a>

            <a asp-controller="Announcements" asp-action="Index" class="quick-btn">
                <div class="qb-icon" style="color:#ff9f1c"><i class="fas fa-bullhorn"></i></div>
                <div>
                    <div class="font-weight-bold">Quản lý Thông báo</div>
                    <div class="small text-white-50">Gửi tin toàn trường</div>
                </div>
            </a>

            <a asp-controller="CourseSections" asp-action="Create" class="quick-btn">
                <div class="qb-icon" style="color:#f72585"><i class="fas fa-book-medical"></i></div>
                <div>
                    <div class="font-weight-bold">Mở Lớp học phần</div>
                    <div class="small text-white-50">Xếp lịch & phòng</div>
                </div>
            </a>
        </div>
    </div>
</div>