@using Microsoft.AspNetCore.Identity
@using StudentPortal.Models
@using System.Globalization
@inject UserManager<User> UserManager

@{
    Layout = "_LecturerLayout";
    ViewData["Title"] = "Bảng điều khiển Giảng viên";

    // 1. [AN TOÀN] Ép kiểu an toàn: Nếu null thì tạo List rỗng để tránh lỗi Crash trang
    var teachingList = ViewData["teachingList"] as List<StudentPortal.Models.CourseSection>
                       ?? new List<StudentPortal.Models.CourseSection>();

    // 2. Lấy thông báo lỗi và tên học kỳ
    var errorMessage = ViewData["ErrorMessage"] as string;
    var currentSemesterName = ViewData["CurrentSemester"] as string;
}

<div class="container-fluid mt-3">

    @* --- 3. PHẦN HIỂN THỊ THÔNG BÁO LỖI (NẾU CÓ) --- *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning text-center shadow-sm mb-4" role="alert" style="border-radius: 15px; border-left: 5px solid #ffc107; background-color: rgba(255, 193, 7, 0.1); color: #856404;">
            <h5 class="alert-heading" style="font-weight: bold; font-size: 1.1rem;">
                <i class="zmdi zmdi-alert-triangle mr-2"></i> Thông báo
            </h5>
            <p class="mb-0">@errorMessage</p>
        </div>
    }

    <div class="card mt-3">
        <div class="card-content">
            <div class="row row-group m-0">
                @* Cột 1: Lời chào *@
                <div class="col-12 col-lg-6 col-xl-6 border-light">
                    <div class="card-body" style="display: flex; flex-direction: column; justify-content: center; min-height: 100px;">
                        <h4 class="mb-2 text-white font-weight-bold">Xin chào, @ViewData["Name"]</h4>

                        <p class="mb-0 text-white small-font" style="opacity: 0.8">
                            @if (!string.IsNullOrEmpty(currentSemesterName))
                            {
                                <span class="badge badge-light text-dark mr-1" style="font-size: 0.8rem">@currentSemesterName</span>
                                <span>Chúc thầy/cô một ngày làm việc hiệu quả.</span>
                            }
                            else
                            {
                                <span>Chúc thầy/cô một ngày làm việc hiệu quả.</span>
                            }
                        </p>
                    </div>
                </div>

                @* Cột 2: Số lượng môn *@
                <div class="col-12 col-lg-3 col-xl-3 border-light">
                    <div class="card-body">
                        @* teachingList.Count sẽ bằng 0 nếu list rỗng (không bị lỗi) *@
                        <h4 class="mb-2 text-white font-weight-bold">@teachingList.Count</h4>
                        <p class="mb-0 text-white small-font" style="opacity: 0.8">
                            <i class="zmdi zmdi-collection-bookmark mr-1"></i> Môn học đảm nhiệm
                        </p>
                    </div>
                </div>

                @* Cột 3: Tổng sinh viên *@
                <div class="col-12 col-lg-3 col-xl-3 border-light">
                    <div class="card-body">
                        @* Tính tổng an toàn, coi null là 0 *@
                        <h4 class="mb-2 text-white font-weight-bold">
                            @teachingList.Sum(x => (int?)x.Capacity ?? 0)
                        </h4>
                        <p class="mb-0 text-white small-font" style="opacity: 0.8">
                            <i class="zmdi zmdi-accounts-outline mr-1"></i> Tổng sinh viên quản lý
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title text-white mb-0">
                            <i class="zmdi zmdi-calendar-check mr-2"></i> Lịch giảng dạy hôm nay
                        </h5>
                        <a href="@Url.Action("LecturerSchedule", "Schedule")" class="btn btn-sm btn-light text-dark font-weight-bold shadow-sm">
                            Xem chi tiết tuần này <i class="fa fa-arrow-right ml-1"></i>
                        </a>
                    </div>

                    <hr style="border-top: 1px solid rgba(255,255,255,0.1);">

                    @* Partial View hiển thị lịch *@
                    <partial name="_LecturerCalendarPatial" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/plugins/Chart.js/Chart.min.js"></script>
    <script src="~/assets/js/index.js"></script>
}