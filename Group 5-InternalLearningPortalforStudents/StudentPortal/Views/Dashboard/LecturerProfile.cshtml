@using StudentPortal.Models
@{
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    ViewData["Title"] = "Thông tin cá nhân";
    var listCourses = ViewData["CourseList"] as List<StudentPortal.Models.Course>;
}

<style>
    .nav-link {
        cursor: pointer;
    }
</style>

<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="profile-header-banner">
                    <div class="banner-content text-right p-4">
                        <h3 class="mt-5">WELCOME TO UEF</h3>
                        <p>Be who you want to be</p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-lg-2 col-md-3">
                        <div class="profile-user-avatar">
                            <img id="avatarPreview" src="@(string.IsNullOrEmpty(Model.User.ImagePath) ? "https://via.placeholder.com/150" : Model.User.ImagePath)"
                                 style="width:120px; height:120px; object-fit:cover; border-radius:50%; border: 3px solid #eee;" />
                        </div>
                    </div>
                    <div class="col-lg-10 col-md-9">
                        <div class="profile-user-info mt-3 mt-md-0 ml-md-3">
                            <h4 class="mb-1">@ViewData["Name"]</h4>
                            <p class="mb-0"><i class="fa fa-desktop mr-1"></i> @ViewData["Faculty"] &nbsp;|&nbsp; <i class="fa fa-map-marker mr-1"></i>@ViewData["City"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border-top">
                <ul class="nav nav-pills nav-pills-primary">
                    <li class="nav-item">
                        <a href="javascript:void(0);" class="nav-link active"><i class="icon-user"></i> Hồ sơ cá nhân</a>
                    </li>
                    <li class="nav-item">
                        <a href="javascript:void(0);" onclick="openProfileModal()" class="nav-link">
                            <i class="fa fa-pencil-square-o"></i> Cập nhật thông tin
                        </a>
                    </li>
                </ul>
                <div id="modal-placeholder"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mt-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title text-uppercase pb-2">Thông tin liên hệ</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fa fa-envelope-o mr-2"></i> <strong>Email:</strong> @ViewData["Email"]</li>
                    <li class="mb-2"><i class="fa fa-phone mr-2"></i> <strong>SĐT:</strong> @ViewData["PhoneNumber"]</li>
                </ul>
                <hr>
                <h5 class="card-title text-uppercase pb-2">Thành viên của</h5>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-university"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Trường đại học</h6>
                        <p class="mb-0 small">UEF Đại học Kinh tế - Tài chính</p>
                    </div>
                </div>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-briefcase"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Khoa</h6>
                        <p class="mb-0 small"> @ViewData["Faculty"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row mt-3">
            <div class="col-12 col-lg-6">
                <div class="card text-white" style="border: 1px solid rgba(255,255,255,0.15);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-white">Số lớp đã dạy</p>
                                <h4 class="mb-0 text-white mt-2">@ViewData["TotalClass"]</h4>
                            </div>
                            <div class="ml-auto font-35 text-white"><i class="fa fa-book"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Danh sách các môn học (Giảng dạy)</h5>

                <div class="table-responsive custom-table-scroll">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Mã học phần</th>
                                <th scope="col">Tên môn học</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listCourses != null && listCourses.Any())
                            {
                                int STT = 1;
                                foreach (var item in listCourses)
                                {
                                    <tr>
                                        <th scope="row">@(STT++)</th>

                                        <td>@item.CourseCode</td>

                                        <td>@item.CourseName</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center">Giảng viên chưa đăng ký môn học nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-link {
        cursor: pointer;
    }

    /* --- CẤU HÌNH SCROLL CHO BẢNG --- */
    .custom-table-scroll {
        /* Header (~50px) + 2 dòng (mỗi dòng ~55px) = ~160px */
        /* Giảm xuống 165px để chỉ hiện 2 dòng, dòng thứ 3 sẽ bị che và hiện scroll */
        max-height: 165px;
        overflow-y: auto; /* Tự động hiện thanh cuộn dọc khi vượt quá chiều cao */
        display: block; /* Đảm bảo div hoạt động như một khối hộp */
        width: 100%;
    }

        /* Tùy chỉnh thanh cuộn cho đẹp (chỉ chạy trên Chrome/Safari/Edge) */
        .custom-table-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .custom-table-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .custom-table-scroll::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 3px;
        }

            .custom-table-scroll::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

        /* --- (Quan trọng) Cố định tiêu đề bảng khi cuộn --- */
        .custom-table-scroll table thead th {
            position: sticky;
            top: 0;
            /* SỬA DÒNG NÀY: Đổi từ #fff (trắng) sang màu tối (ví dụ #2c3e50 hoặc #343a40) */
            background-color: #343a40;
            /* THÊM DÒNG NÀY: Để chữ tiêu đề có màu trắng cho dễ đọc */
            color: #ffffff;
            z-index: 1;
            box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.5);
        }
</style>

@section Scripts {
<script>
    // --- PHẦN 1: CẤU HÌNH XEM TRƯỚC ẢNH (QUAN TRỌNG) ---
    // Dùng $(document).on(...) để "đón lõng" sự kiện, kể cả khi Modal chưa hiện ra
    $(document).on('change', '#avatarFile', function (e) {
        if (e.target.files && e.target.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                // SỬA DÒNG NÀY: Trỏ vào ID mới bên trong Modal
                $('#avatarPreviewModal').attr('src', e.target.result);
            }

            reader.readAsDataURL(e.target.files[0]);
        }
    });

    // --- PHẦN 2: HÀM MỞ MODAL VÀ XỬ LÝ LƯU ---
    function openProfileModal() {
        $.get('/Dashboard/EditLecturerProfile', function (data) {
            $('#modal-placeholder').html(data);
            $('#profileModal').modal('show');

            // Xử lý nút LƯU (Submit form)
            $('#editProfileForm').off('submit').on('submit', function (e) {
                e.preventDefault();

                var form = $(this)[0];
                var formData = new FormData(form);

                // Hiển thị loading hoặc disable nút lưu nếu cần
                var btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang lưu...');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $('#profileModal').modal('hide');
                            location.reload(); // Reload trang để cập nhật hết
                        } else {
                            // Nếu lỗi validate, hiện lại form
                            $('#modal-placeholder').html(response);
                            btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thông tin');
                        }
                    },
                    error: function(xhr, status, error) {
                        alert("Lỗi hệ thống: " + error);
                        btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thông tin');
                    }
                });
            });
        });
    }
</script>

}