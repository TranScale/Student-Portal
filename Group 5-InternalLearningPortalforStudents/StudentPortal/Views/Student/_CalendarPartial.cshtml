@using StudentPortal.Models
@using System.Globalization

@{
    // 1. LẤY DỮ LIỆU TRỰC TIẾP TỪ VIEWDATA (Được thừa hưởng từ Index)
    // Lưu ý: Key phải khớp y chang bên Controller
    var selectedDate = ViewData["selectedDate"] as DateTime? ?? DateTime.Today;
    var listSchedule = ViewData["ListSchedule"] as List<ScheduleItem>;

    // 2. LOGIC TÍNH TOÁN LỊCH
    var firstDayOfMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
    int offset = firstDayOfMonth.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)firstDayOfMonth.DayOfWeek - 1;
    var startCalendarDate = firstDayOfMonth.AddDays(-offset);
}

<div class="row">
    <div class="col-12 col-lg-5 mb-3">
        <div class="card h-100 mb-0" style="background-color: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); min-height: 380px;">
            <div class="card-header d-flex justify-content-between align-items-center border-0 p-2">
                <a href="@Url.Action("Index", new { date = selectedDate.AddMonths(-1) })" class="btn btn-sm text-white-50">
                    <i class="fa fa-chevron-left"></i>
                </a>

                <span class="font-weight-bold text-white">Tháng @selectedDate.Month - @selectedDate.Year </span>

                <a href="@Url.Action("Index", new { date = selectedDate.AddMonths(1) })" class="btn btn-sm text-white-50">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </div>
            <div class="card-body p-2">
                <table class="table table-borderless table-sm text-center text-white mb-0" style="font-size: 0.85rem;">
                    <thead>
                        <tr class="text-white-50">
                            <th class="p-1">T2</th>
                            <th class="p-1">T3</th>
                            <th class="p-1">T4</th>
                            <th class="p-1">T5</th>
                            <th class="p-1">T6</th>
                            <th class="p-1">T7</th>
                            <th class="text-danger p-1">CN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var currentDay = startCalendarDate;
                            for (int row = 0; row < 6; row++)
                            {
                                <tr>
                                    @for (int col = 0; col < 7; col++)
                                    {
                                        bool isSelected = currentDay.Date == selectedDate.Date;
                                        bool isCurrentMonth = currentDay.Month == selectedDate.Month;
                                        string spanStyle = isSelected
                                        ? "display:inline-block; width:28px; height:28px; line-height:26px; border: 1px solid #fff; border-radius: 50%; font-weight: bold; background: rgba(255,255,255,0.1);"
                                        : "display:inline-block; width:28px; height:28px; line-height:26px;";
                                        string textClass = isCurrentMonth ? "text-white" : "text-white-50";

                                        // Lưu biến để dùng trong thẻ a
                                        var dateParam = currentDay;

                                        <td class="p-1">
                                            <a href="@Url.Action("Index", new { date = dateParam })" class="text-decoration-none @textClass">
                                                <span style="@spanStyle">@currentDay.Day</span>
                                            </a>
                                        </td>
                                        currentDay = currentDay.AddDays(1);
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 mb-3">
        <div class="card h-100 mb-0" style="background-color: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); min-height: 380px;">
            <div class="card-header d-flex justify-content-between align-items-center border-bottom border-light-3 p-2 pl-3 pr-3">
                <span class="text-white font-weight-bold">
                    <i class="fa fa-calendar-check-o mr-2"></i>Lịch học ngày @selectedDate.ToString("dd/MM/yyyy")
                </span>
            </div>

            <div class="card-body p-0" style="height: 330px; overflow-y: auto;">
                <ul class="list-group list-group-flush bg-transparent">
                    @if (listSchedule != null && listSchedule.Any())
                    {
                        foreach (var item in listSchedule)
                        {
                            <li class="list-group-item bg-transparent border-light-3 py-2">
                                <div class="d-flex">
                                    <div class="mr-2 mt-1">
                                        <span class="badge @GetBadgeColor(item.CourseSection.Sessions)">
                                            @GetTimeFromSession(item.CourseSection.Sessions)
                                        </span>
                                    </div>
                                    <div style="flex: 1;">
                                        <h6 class="mb-1 text-white font-weight-bold" style="font-size: 0.85rem; line-height: 1.3;">
                                            @item.CourseSection.Course.CourseName
                                        </h6>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">
                                            <span class="text-success">
                                                <i class="fa fa-map-marker mr-1"></i> @(item.CourseSection.Room ?? "Online/Chưa xếp")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item bg-transparent border-0 py-5 text-center">
                            <div class="text-white-50">
                                <i class="fa fa-coffee fa-3x mb-3" style="opacity: 0.5"></i><br />
                                Không có lịch học nào trong ngày này.
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@functions {
    // Các hàm helper
    public string GetTimeFromSession(StudySessions session)
    {
        if ((session & StudySessions.Ca1) != 0) return "07:00 - 09:15";
        if ((session & StudySessions.Ca2) != 0) return "09:30 - 11:45";
        if ((session & StudySessions.Ca3) != 0) return "12:30 - 14:45";
        if ((session & StudySessions.Ca4) != 0) return "15:00 - 17:15";
        if ((session & StudySessions.Ca5) != 0) return "17:30 - 19:45";
        return "Tự do";
    }

    public string GetBadgeColor(StudySessions session)
    {
        if ((session & StudySessions.Ca1) != 0 || (session & StudySessions.Ca2) != 0) return "badge-primary";
        if ((session & StudySessions.Ca3) != 0 || (session & StudySessions.Ca4) != 0) return "badge-warning";
        return "badge-success";
    }
}