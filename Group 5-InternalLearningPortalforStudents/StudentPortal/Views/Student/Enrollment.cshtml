@using StudentPortal.Models
@{
    var availableList = ViewData["AvailableList"] as List<CourseSection> ?? new List<CourseSection>();
    var registeredList = ViewData["RegisteredList"] as List<Enrollment> ?? new List<Enrollment>();
    var semesterName = ViewData["SemesterName"] as string;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}


<div class="col-lg-12 mb-4">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header">
                <i class="fa fa-list-alt mr-2"></i> Danh sách môn học mở cho đăng ký
            </h5>

            <form method="post" asp-action="SubmitRegistration" asp-controller="Student">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-reg table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 40px;"><i class="fa fa-check-square-o"></i></th>
                                <th>Mã MH</th>
                                <th>Tên môn học</th>
                                <th>Nhóm</th>
                                <th>Số TC</th>
                                <th>Lớp</th>
                                <th>Sĩ số</th>
                                <th>Còn lại</th>
                                <th>Thời khóa biểu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (availableList.Count > 0)
                            {
                                foreach (var item in availableList)
                                {
                                    int remaining = item.Capacity - item.Enrollments.Count;
                                    <tr>
                                        <td>
                                            @if (remaining > 0)
                                            {
                                                <input type="checkbox" name="selectedCourses" value="@item.CourseSectionId" class="big-checkbox" />
                                            }
                                            else
                                            {
                                                <span class="text-danger"><i class="fa fa-ban"></i></span>
                                            }
                                        </td>
                                        <td>@item.Course?.CourseCode</td>
                                        <td class="text-left font-weight-bold">@item.Course?.CourseName</td>
                                        <td>@item.Room</td>
                                        <td>@item.Course?.CourseCredit</td>
                                        <td>@item.Room</td>
                                        <td>@item.Capacity</td>
                                        <td class="@(remaining <= 0 ? "text-danger font-weight-bold" : "text-success")">
                                            @remaining
                                        </td>
                                        <td class="text-left" style="font-size: 0.75rem;">
                                            @{
                                                string scheduleText = "";
                                                if ((item.Days & ClassDays.Monday) != 0) { scheduleText += "Thứ 2, "; }
                                                if ((item.Days & ClassDays.Tuesday) != 0) { scheduleText += "Thứ 3, "; }
                                                if ((item.Days & ClassDays.Wednesday) != 0) { scheduleText += "Thứ 4, "; }
                                                // ... (viết thêm các thứ khác nếu cần)

                                                string sessionText = item.Sessions.ToString(); // Ví dụ: Ca1
                                            }
                                            <i class="fa fa-clock-o"></i> @scheduleText (@sessionText) <br />
                                            <i class="fa fa-map-marker"></i> @item.Room <br />
                                            <i class="fa fa-user"></i> @(item.Lecturer?.User?.FullName ?? "GV")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">Không có môn học nào để đăng ký</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-right">
                    <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                        <i class="fa fa-pencil-square-o mr-2"></i> Đăng ký môn học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="col-lg-12">
    <div class="card card-transparent">
        <div class="card-body">
            <h5 class="reg-card-header" style="border-bottom-color: #28a745;">
                <i class="fa fa-check-circle mr-2"></i> Môn đã đăng ký
                <span style="font-size: 0.9rem; float: right; color: #ffd700;">
                    (Tổng: @registeredList.Count môn - @registeredList.Sum(x => x.CourseSection?.Course?.CourseCredit ?? 0) tín chỉ)
                </span>
            </h5>

            <div class="table-responsive">
                <table class="table table-reg table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 50px;">Xóa</th>
                            <th>Mã MH</th>
                            <th>Tên môn học</th>
                            <th>Nhóm</th>
                            <th>Số TC</th>
                            <th>Học phí</th>
                            <th>Lớp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (registeredList.Count > 0)
                        {
                            foreach (var item in registeredList)
                            {
                                <tr>
                                    <td>
                                        <form method="post" asp-action="CancelRegistration" asp-controller="Student" asp-route-id="@item.EnrollmentId" onsubmit="return confirm('Bạn có chắc muốn hủy môn này?');">
                                            <button type="submit" class="btn-delete" title="Hủy môn">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>@item.CourseSection?.Course?.CourseCode</td>
                                    <td class="text-left font-weight-bold" style="color: #0056b3;">
                                        @item.CourseSection?.Course?.CourseName
                                    </td>
                                    <td>@item.CourseSection?.Room</td>
                                    <td class="text-left font-weight-bold" style="color: #00d4ff;">
                                        @item.CourseSection?.Course?.CourseName
                                    </td>
                                    <td>
                                        @string.Format("{0:N0}", (item.CourseSection?.Course?.CourseCredit ?? 0) * 850000)
                                    </td>
                                    <td>@item.CourseSection?.Room</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4">Chưa đăng ký môn học nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* 1. Card trong suốt hoàn toàn để lộ nền web */
    .card-transparent {
        background-color: rgba(255, 255, 255, 0.05); /* Màu trắng cực mờ (5%) */
        border: 1px solid rgba(255, 255, 255, 0.2); /* Viền mờ */
        border-radius: 15px; /* Bo góc mềm mại */
        backdrop-filter: blur(5px); /* Hiệu ứng kính mờ nhẹ (tùy chọn) */
    }

    /* 2. Tiêu đề Card */
    .reg-card-header {
        border-bottom: 2px solid #dc3545; /* Giữ gạch chân đỏ */
        padding-bottom: 10px;
        margin-bottom: 15px;
        color: #fff; /* Chữ trắng */
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* 3. Bảng trong suốt (Quan trọng) */
    .table-reg th {
        background-color: rgba(255, 255, 255, 0.2); /* Header bảng sáng hơn nền một chút */
        color: #fff; /* Chữ header màu trắng */
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
        font-size: 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.1); /* Viền mờ */
    }

    .table-reg td {
        background-color: transparent; /* Nền ô trong suốt */
        color: #fff; /* Chữ nội dung màu trắng */
        vertical-align: middle;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.1); /* Viền mờ */
        text-align: center;
    }

    /* Hover vào dòng thì sáng lên xíu cho dễ nhìn */
    .table-reg tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Cột Tên môn học canh trái */
    .text-left {
        text-align: left !important;
    }

    /* Nút xóa */
    .btn-delete {
        color: #ff6b6b; /* Đỏ sáng để nổi trên nền tối */
        background: none;
        border: none;
        font-weight: bold;
        font-size: 1.2rem;
        transition: 0.2s;
    }

        .btn-delete:hover {
            color: #ff0000;
            transform: scale(1.2);
        }

    /* Checkbox to hơn */
    .big-checkbox {
        transform: scale(1.3);
        cursor: pointer;
    }

    /* Custom scrollbar cho đẹp nếu bảng dài */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 3px;
    }
</style>