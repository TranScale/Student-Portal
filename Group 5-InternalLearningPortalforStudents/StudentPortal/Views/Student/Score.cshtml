@using StudentPortal.Models
@model IEnumerable<Score>
@{
    ViewData["Title"] = "Xem điểm";

    // 1. Lấy dữ liệu từ ViewData ép kiểu về List
    var listScores = ViewData["ListScores"] as List<Score>;

    // 2. Khởi tạo biến để tính toán thống kê
    double diemTB_He10 = 0;
    double diemTB_He4 = 0;
    int tongTinChiHocKy = 0;
    int soTinChiDat = 0;

    // Biến tạm để tính tổng tích lũy cho học kỳ này
    double tongDiemTinChi_10 = 0;
    double tongDiemTinChi_4 = 0;

    if (listScores != null && listScores.Any())
    {
        foreach (var item in listScores)
        {
            // Lấy số tín chỉ của môn
            int tinChi = item.CourseSection?.Course?.CourseCredit ?? 0;

            // Lấy điểm hệ 10
            float d10 = item.FinalScore;

            // Quy đổi sang hệ 4 (Quy tắc thông thường)
            double d4 = 0;
            if (d10 >= 8.5) { d4 = 4.0; }
            else if (d10 >= 7.0) { d4 = 3.0; }
            else if (d10 >= 5.5) { d4 = 2.0; }
            else if (d10 >= 4.0) { d4 = 1.0; }
            else { d4 = 0; }

            // Cộng dồn tính toán
            tongTinChiHocKy += tinChi;
            tongDiemTinChi_10 += (d10 * tinChi);
            tongDiemTinChi_4 += (d4 * tinChi);

            // Kiểm tra qua môn (Giả sử >= 4.0 là qua môn)
            if (d10 >= 4.0)
            {
                soTinChiDat += tinChi;
            }
        }

        // Tính trung bình
        if (tongTinChiHocKy > 0)
        {
            diemTB_He10 = tongDiemTinChi_10 / tongTinChiHocKy;
            diemTB_He4 = tongDiemTinChi_4 / tongTinChiHocKy;
        }
    }
}
<div class="container-fluid p-0">
    <div class="uef-header-section mb-3">
        <h6 class="font-weight-bold">
            <i class="fa fa-cog uef-icon-red mr-2"></i> HỌC KỲ - NĂM HỌC
        </h6>
        <div class="uef-red-line"></div>
    </div>

    <div class="uef-filter-box">
        <form method="get" asp-action="Score">
            <div class="row mb-3">
                <div class="col-md-6 mb-2 mb-md-0">
                    <select class="form-control custom-select-uef"
                            name="semesterId"
                            asp-items="@(ViewData["SemesterList"] as SelectList)"
                            onchange="this.form.submit()">
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="col-lg-12">
    <div class="card bg-transparent">
        <div class="card-body">
            <div class="table-responsive custom-table-scroll">
                <table class="table table-hover text-white">
                    <thead>
                        <tr style="background-color: rgba(0,0,0,0.2);">
                            <th scope="col">Stt</th>
                            <th scope="col">Mã MH <i class="fa fa-caret-up"></i></th>
                            <th scope="col">Nhóm/Tổ</th>
                            <th scope="col">Tên môn học</th>
                            <th scope="col" class="text-center">Số TC</th>
                            <th scope="col">Đ.Quá trình (30%)</th>
                            <th scope="col">Đ.Giữa kỳ (20%)</th>
                            <th scope="col">Đ.Thi</th>
                            <th scope="col">Điểm TK (10)</th>
                            <th scope="col">Điểm TK (C)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="font-weight-bold" style="background-color: rgba(255,255,255,0.2); color: #fff;">
                            <td colspan="10">@ViewData["CurrentSemesterName"]</td>
                        </tr>

                        @if (listScores != null && listScores.Any())
                        {
                            int stt = 1;
                            foreach (var item in listScores)
                            {
                                <tr>
                                    <th scope="row">@(stt++)</th>
                                    <td>@item.CourseSection?.Course?.CourseCode</td>
                                    <td>@item.CourseSection?.Room</td>
                                    <td>@item.CourseSection?.Course?.CourseName</td>
                                    <td class="text-center">@item.CourseSection?.Course?.CourseCredit</td>

                                    <td>@item.ProcessScore</td>
                                    <td>@item.MiddleScore</td>
                                    <td>@item.ExamScore</td>

                                    <td class="font-weight-bold">@item.FinalScore</td>
                                    <td class="font-weight-bold text-warning">@item.Value</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-3">Chưa có dữ liệu điểm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 rounded" style="background-color: rgba(255, 255, 255, 0.1); color: #fff; font-size: 0.9rem;">
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-unstyled mb-0">
                            <li>- Điểm trung bình học kỳ hệ 4: <span class="font-weight-bold">@diemTB_He4.ToString("N2")</span></li>
                            <li>- Điểm trung bình học kỳ hệ 10: <span class="font-weight-bold">@diemTB_He10.ToString("N2")</span></li>
                            <li>- Số tín chỉ đạt học kỳ: <span class="font-weight-bold">@soTinChiDat</span> / @tongTinChiHocKy</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
