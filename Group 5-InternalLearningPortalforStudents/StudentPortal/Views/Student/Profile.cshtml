@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="profile-header-banner">
                    <div class="banner-content text-right p-4">
                        <h3 class="mt-5">WELCOME TO UEF</h3>
                        <p>Be who you want to be</p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-lg-2 col-md-3">
                        <div class="profile-user-avatar">
                            <img src="https://via.placeholder.com/150" class="img-fluid img-thumbnail rounded" alt="user avatar">
                        </div>
                    </div>
                    <div class="col-lg-10 col-md-9">
                        <div class="profile-user-info mt-3 mt-md-0 ml-md-3">
                            <h4 class="mb-1">Trần Học Trò</h4>
                            <p class="mb-0"><i class="fa fa-desktop mr-1"></i> Công nghệ thông tin &nbsp;|&nbsp; <i class="fa fa-map-marker mr-1"></i> Hồ Chí Minh</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border-top">
                <ul class="nav nav-pills nav-pills-primary">
                    <li class="nav-item">
                        <a href="javascript:void();" class="nav-link active"><i class="icon-user"></i> Hồ sơ cá nhân</a>
                    </li>
                    <li class="nav-item">
                        <a href="javascript:void();" class="nav-link"><i class="icon- "></i> Thông tin cá nhân </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mt-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title text-uppercase pb-2">Thông tin liên hệ</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fa fa-envelope-o mr-2"></i> <strong>Email:</strong> troth@uef.edu.vn</li>
                    <li class="mb-2"><i class="fa fa-id-card-o mr-2"></i> <strong>MSSV:</strong> 225051529</li>
                    <li class="mb-2"><i class="fa fa-phone mr-2"></i> <strong>SĐT:</strong> 0898445830</li>
                </ul>
                <hr>
                <h5 class="card-title text-uppercase pb-2">Thành viên của</h5>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-university"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Trường đại học</h6>
                        <p class="mb-0 small">UEF Đại học Kinh tế - Tài chính</p>
                    </div>
                </div>
                <div class="media align-items-center mb-3">
                    <div class="icon-box mr-3"><i class="fa fa-briefcase"></i></div>
                    <div class="media-body">
                        <h6 class="mt-0 mb-1">Khoa</h6>
                        <p class="mb-0 small">Công Nghệ Thông Tin</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row mt-3">
            <div class="col-12 col-lg-6">
                <div class="card text-white" style="border: 1px solid rgba(255,255,255,0.15);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-white">Điểm TB Tích lũy</p>
                                <h4 class="mb-0 text-white mt-2">3.42</h4>
                            </div>
                            <div class="ml-auto font-35 text-white"><i class="fa fa-graduation-cap"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card text-white" style="border: 1px solid rgba(255,255,255,0.15);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div>
                                <p class="mb-0 text-white">Tín chỉ đã học</p>
                                <h4 class="mb-0 text-white mt-2">135</h4>
                            </div>
                            <div class="ml-auto font-35 text-white"><i class="fa fa-book"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Danh sách các môn học</h5>

                <div class="table-responsive custom-table-scroll">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Mã học phần</th>
                                <th scope="col">Tên môn học</th>
                                <th scope="col">Số TC</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">1</th>
                                <td>CSC101</td>
                                <td>Lập trình Web ASP.NET</td>
                                <td>3</td>
                            </tr>
                            <tr>
                                <th scope="row">2</th>
                                <td>ENG202</td>
                                <td>Tiếng Anh chuyên ngành 2</td>
                                <td>3</td>
                            </tr>
                            <tr>
                                <th scope="row">3</th>
                                <td>SOFT01</td>
                                <td>Kỹ năng mềm</td>
                                <td>2</td>
                            </tr>
                            <tr>
                                <th scope="row">4</th>
                                <td>TEST01</td>
                                <td>Môn test cho dài ra 1</td>
                                <td>2</td>
                            </tr>
                            <tr>
                                <th scope="row">5</th>
                                <td>TEST02</td>
                                <td>Môn test cho dài ra 2</td>
                                <td>2</td>
                            </tr>
                            <tr>
                                <th scope="row">6</th>
                                <td>TEST03</td>
                                <td>Môn test cho dài ra 3</td>
                                <td>2</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

