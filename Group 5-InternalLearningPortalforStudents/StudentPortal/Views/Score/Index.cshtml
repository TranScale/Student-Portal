@* Views/Score/Index.cshtml *@
@using StudentPortal.Models

@{
    ViewData["Title"] = "Tra cứu điểm";
    string role = ViewBag.Role as string;
}

<div class="container mt-4">
    @if (role == "Student")
    {
        var scores = Model as List<Score>;
        <h2>Bảng điểm của tôi</h2>
        @* ... Code bảng điểm sinh viên ... *@
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Môn học</th>
                    <th>Quá trình (30%)</th>
                    <th>Giữa kỳ (20%)</th>
                    <th>Cuối kỳ (50%)</th>
                    <th>Tổng kết</th>
                </tr>
            </thead>
            <tbody>
                @if (scores != null)
                {
                    foreach (var item in scores)
                    {
                        <tr>
                            <td>@item.CourseSection?.Course?.CourseName</td>
                            <td>@item.ProcessScore</td>
                            <td>@item.MiddleScore</td>
                            <td>@item.ExamScore</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else if (role == "Lecturer")
    {
        // Ép kiểu Model về List<CourseSection>
        var sections = Model as List<CourseSection>;

        <h2 class="text-success">Danh sách lớp phụ trách</h2>
        <table class="table table-striped table-hover">
            <thead class="bg-success text-white">
                <tr>
                    <th>Mã Lớp HP</th>
                    <th>Tên môn</th>
                    <th>Phòng học</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (sections != null)
                {
                    foreach (var item in sections)
                    {
                        <tr>
                            <td>@item.CourseSectionId</td>

                            <td>@item.Course?.CourseName</td>
                            <td>@item.Room</td>
                            <td>
                                <a asp-action="EnterGrades" asp-route-sectionId="@item.CourseSectionId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i> Nhập điểm
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>