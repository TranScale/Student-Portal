@model List<StudentPortal.Models.CourseSection>

@{
    Layout = "_LecturerLayout";
    ViewData["Title"] = "Quản lý điểm thành phần";
}

<style>
    /* --- STYLE GIỮ NGUYÊN TỪ CŨ --- */

    /* 1. Thanh công cụ (Filter Bar) phía trên */
    .filter-toolbar {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 15px;
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Icon bên trái text */
    .input-icon {
        color: #fff;
        margin-right: 15px;
        opacity: 0.9;
        font-size: 1.5rem;
    }

    /* 2. Card chứa bảng dữ liệu */
    .glass-card {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #fff;
        padding-bottom: 20px;
    }

    .glass-header {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* 3. Bảng (Table) */
    .table-dark-custom {
        width: 100%;
        color: #fff;
        margin-bottom: 0;
    }

        .table-dark-custom thead th {
            background-color: rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            padding: 12px 15px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #ccc;
        }

        .table-dark-custom tbody td {
            padding: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-dark-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

    /* Badge & Button */
    .btn-action-purple {
        background: linear-gradient(45deg, #8e44ad, #9b59b6);
        border: none;
        color: white;
        padding: 6px 15px;
        border-radius: 4px;
        font-size: 0.85rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        transition: all 0.3s;
    }

        .btn-action-purple:hover {
            background: linear-gradient(45deg, #71368a, #8e44ad);
            color: white;
            transform: translateY(-1px);
        }

    .badge-room {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .text-highlight {
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
    }

    .text-sub {
        color: #aaa;
        font-size: 0.85rem;
        display: block;
        margin-top: 2px;
    }

    /* --- STYLE MỚI: CHO DROPDOWN SELECT --- */
    .semester-select {
        background-color: transparent; /* Nền trong suốt */
        border: none;
        border-bottom: 1px solid rgba(255,255,255,0.3); /* Chỉ hiện gạch chân mờ */
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        padding: 5px 30px 5px 0;
        outline: none;
        width: 100%;
        min-width: 250px;
        /* Icon mũi tên tùy chỉnh (màu trắng) */
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0 center;
        background-size: 1em;
    }

        /* Style cho các option bên trong (tránh bị nền trắng mặc định của trình duyệt) */
        .semester-select option {
            background-color: #2c3e50; /* Màu nền tối khớp theme */
            color: #fff;
            padding: 10px;
        }

        .semester-select:focus {
            border-bottom: 1px solid rgba(255,255,255,0.8);
        }
</style>

<div class="container-fluid" style="padding-top: 20px;">

    <div class="filter-toolbar">
        <div class="d-flex align-items-center w-100">
            <i class="fa fa-calendar-check input-icon"></i>
            <div style="flex-grow: 1;">
                <div style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 2px;">
                    Chọn học kỳ làm việc
                </div>

                <form asp-action="Index" method="get" id="semesterFilterForm">
                    <select name="semesterId"
                            class="semester-select"
                            asp-items="ViewBag.ActiveSemesters"
                            onchange="document.getElementById('semesterFilterForm').submit()">
                    </select>
                </form>
            </div>
        </div>
    </div>

    <div class="glass-card">
        <div class="glass-header">
            <span><i class="fa fa-list mr-2"></i> Danh sách lớp học phần</span>
        </div>

        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">#</th>
                        <th>Mã Học Phần</th>
                        <th>Tên Môn Học</th>
                        <th>Phòng</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@stt</td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseCode</span>
                                </td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseName</span>
                                    <span class="text-sub">@item.Course?.CourseCredit tín chỉ</span>
                                </td>
                                <td>
                                    <span class="badge-room">@item.Room</span>
                                </td>
                                <td class="text-right">
                                    <button type="button"
                                            class="btn btn-action-purple"
                                            onclick="openGradeModal(@item.CourseSectionId)">
                                        <i class="fa fa-edit mr-1"></i> Nhập điểm
                                    </button>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fa fa-folder-open mb-3" style="font-size: 2rem; opacity: 0.5;"></i>
                                <br />
                                <span style="opacity: 0.5;">Không tìm thấy lớp học phần nào trong học kỳ này.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script>
        function openGradeModal(sectionId) {
            // Hiệu ứng loading con trỏ chuột
            $('body').css('cursor', 'wait');

            $.get('/Score/EnterGrades', { sectionId: sectionId })
                .done(function (data) {
                    $('#modalContainer').html(data);
                    $('#gradeModal').modal('show'); // Đảm bảo ID modal trong PartialView là 'gradeModal'
                })
                .fail(function() {
                    alert("Không thể tải dữ liệu bảng điểm. Vui lòng thử lại.");
                })
                .always(function() {
                    $('body').css('cursor', 'default');
                });
        }
    </script>
}