@model List<StudentPortal.Models.CourseSection>

@{
    Layout = "_LecturerLayout";
    ViewData["Title"] = "Quản lý điểm thành phần";
}

<style>
    /* --- STYLE CHUNG CHO TRANG NÀY (Giống Thời khóa biểu) --- */

    /* 1. Thanh công cụ (Filter Bar) phía trên */
    .filter-toolbar {
        background-color: rgba(0, 0, 0, 0.2); /* Nền tối mờ */
        border-radius: 15px; /* Bo tròn mạnh */
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Style cho ô chọn (Select Box) */
    .custom-select-dark {
        background-color: rgba(255, 255, 255, 0.1) !important; /* Nền kính */
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        border-radius: 8px;
        height: 45px;
        padding-left: 15px;
    }

        .custom-select-dark:focus {
            background-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: none;
            border-color: rgba(255, 255, 255, 0.3) !important;
        }

        /* Chỉnh màu option bên trong khi xổ xuống */
        .custom-select-dark option {
            background-color: #2c3e50;
            color: white;
        }

    /* Icon bên trái input */
    .input-icon {
        color: #fff;
        margin-right: 10px;
        opacity: 0.7;
        font-size: 1.2rem;
    }

    /* 2. Card chứa bảng dữ liệu (Main Content) */
    .glass-card {
        background-color: rgba(0, 0, 0, 0.2); /* Nền tối trong suốt giống hình */
        border-radius: 4px; /* Bo góc ít hơn toolbar giống hình */
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #fff;
        padding-bottom: 20px;
    }

    .glass-header {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* 3. Bảng (Table) */
    .table-dark-custom {
        width: 100%;
        color: #fff;
        margin-bottom: 0;
    }

        .table-dark-custom thead th {
            background-color: rgba(255, 255, 255, 0.05); /* Header bảng sáng hơn xíu */
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            padding: 12px 15px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #ccc; /* Màu chữ header hơi xám */
        }

        .table-dark-custom tbody td {
            padding: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.05); /* Đường kẻ rất mờ */
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-dark-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05); /* Hiệu ứng hover nhẹ */
        }

    /* Badge & Button */
    .btn-action-purple {
        background: linear-gradient(45deg, #8e44ad, #9b59b6); /* Tím giống theme */
        border: none;
        color: white;
        padding: 6px 15px;
        border-radius: 4px;
        font-size: 0.85rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

        .btn-action-purple:hover {
            background: linear-gradient(45deg, #71368a, #8e44ad);
            color: white;
        }

    .badge-room {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .text-highlight {
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
    }

    .text-sub {
        color: #aaa;
        font-size: 0.85rem;
        display: block;
        margin-top: 2px;
    }

</style>

<div class="container-fluid" style="padding-top: 20px;">

    <form method="get" asp-action="Index">
        <div class="filter-toolbar">
            <div class="d-flex align-items-center flex-grow-1">
                <i class="fa fa-calendar-alt input-icon"></i>
                <div style="flex-grow: 1; max-width: 400px;">
                    <select class="form-control custom-select-dark"
                            name="semesterId"
                            asp-items="@(ViewData["SemesterList"] as SelectList)"
                            onchange="this.form.submit()">
                    </select>
                </div>
            </div>

            <div class="text-white ml-3 d-none d-md-block" style="opacity: 0.8;">
                <i class="fa fa-info-circle mr-1"></i> Đang xem: @ViewBag.CurrentSemesterName
            </div>
        </div>
    </form>

    <div class="glass-card">
        <div class="glass-header">
            <span><i class="fa fa-list mr-2"></i> Danh sách lớp học phần</span>

            <div>
                <button class="btn btn-sm btn-outline-light border-0" style="opacity: 0.5"><i class="fa fa-chevron-left"></i></button>
                <span class="mx-2" style="font-size: 0.9rem; opacity: 0.8">Hôm nay</span>
                <button class="btn btn-sm btn-outline-light border-0" style="opacity: 0.5"><i class="fa fa-chevron-right"></i></button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">#</th>
                        <th>Mã Học Phần</th>
                        <th>Tên Môn Học</th>
                        <th>Phòng</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@stt</td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseCode</span>
                                </td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseName</span>
                                    <span class="text-sub">@item.Course?.CourseCredit tín chỉ</span>
                                </td>
                                <td>
                                    <span class="badge-room">@item.Room</span>
                                </td>
                                <td class="text-right">
                                    <button type="button"
                                            class="btn btn-action-purple"
                                            onclick="openGradeModal(@item.CourseSectionId)">
                                        <i class="fa fa-edit mr-1"></i> Nhập điểm
                                    </button>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <span style="opacity: 0.5;">Không có dữ liệu lớp học phần.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script>
        function openGradeModal(sectionId) {
            $('body').css('cursor', 'wait');
            $.get('/Score/EnterGrades', { sectionId: sectionId }, function (data) {
                $('body').css('cursor', 'default');
                $('#modalContainer').html(data);
                $('#gradeModal').modal('show');
            });
        }
    </script>
}