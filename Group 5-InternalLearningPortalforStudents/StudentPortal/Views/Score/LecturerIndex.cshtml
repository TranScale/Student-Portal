@model List<StudentPortal.Models.CourseSection>

@{
    Layout = "_LecturerLayout";
    ViewData["Title"] = "Quản lý điểm thành phần";
}

<style>
    /* --- STYLE GIỮ NGUYÊN --- */

    /* 1. Thanh công cụ (Filter Bar) phía trên */
    .filter-toolbar {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 15px;
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Icon bên trái text */
    .input-icon {
        color: #fff;
        margin-right: 15px;
        opacity: 0.9;
        font-size: 1.5rem; /* To hơn xíu để làm điểm nhấn */
    }

    /* Text hiển thị học kỳ */
    .semester-info-text {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* 2. Card chứa bảng dữ liệu */
    .glass-card {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #fff;
        padding-bottom: 20px;
    }

    .glass-header {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* 3. Bảng (Table) */
    .table-dark-custom {
        width: 100%;
        color: #fff;
        margin-bottom: 0;
    }

        .table-dark-custom thead th {
            background-color: rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            padding: 12px 15px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #ccc;
        }

        .table-dark-custom tbody td {
            padding: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-dark-custom tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

    /* Badge & Button */
    .btn-action-purple {
        background: linear-gradient(45deg, #8e44ad, #9b59b6);
        border: none;
        color: white;
        padding: 6px 15px;
        border-radius: 4px;
        font-size: 0.85rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        transition: all 0.3s;
    }

        .btn-action-purple:hover {
            background: linear-gradient(45deg, #71368a, #8e44ad);
            color: white;
            transform: translateY(-1px);
        }

    .badge-room {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .text-highlight {
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
    }

    .text-sub {
        color: #aaa;
        font-size: 0.85rem;
        display: block;
        margin-top: 2px;
    }
</style>

<div class="container-fluid" style="padding-top: 20px;">

    <div class="filter-toolbar">
        <div class="d-flex align-items-center">
            <i class="fa fa-calendar-check input-icon"></i>
            <div>
                <div style="font-size: 0.85rem; opacity: 0.7;">Học kỳ đang diễn ra</div>
                <div class="semester-info-text">
                    @ViewBag.CurrentSemesterName
                </div>
            </div>
        </div>
    </div>

    <div class="glass-card">
        <div class="glass-header">
            <span><i class="fa fa-list mr-2"></i> Danh sách lớp học phần</span>
        </div>

        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">#</th>
                        <th>Mã Học Phần</th>
                        <th>Tên Môn Học</th>
                        <th>Phòng</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@stt</td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseCode</span>
                                </td>
                                <td>
                                    <span class="text-highlight">@item.Course?.CourseName</span>
                                    <span class="text-sub">@item.Course?.CourseCredit tín chỉ</span>
                                </td>
                                <td>
                                    <span class="badge-room">@item.Room</span>
                                </td>
                                <td class="text-right">
                                    <button type="button"
                                            class="btn btn-action-purple"
                                            onclick="openGradeModal(@item.CourseSectionId)">
                                        <i class="fa fa-edit mr-1"></i> Nhập điểm
                                    </button>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fa fa-folder-open mb-3" style="font-size: 2rem; opacity: 0.5;"></i>
                                <br />
                                <span style="opacity: 0.5;">Không tìm thấy lớp học phần nào trong học kỳ này.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script>
        function openGradeModal(sectionId) {
            // Hiệu ứng loading con trỏ chuột
            $('body').css('cursor', 'wait');

            $.get('/Score/EnterGrades', { sectionId: sectionId })
                .done(function (data) {
                    $('#modalContainer').html(data);
                    $('#gradeModal').modal('show'); // Đảm bảo ID modal khớp với PartialView của bạn
                })
                .fail(function() {
                    alert("Không thể tải dữ liệu bảng điểm. Vui lòng thử lại.");
                })
                .always(function() {
                    $('body').css('cursor', 'default');
                });
        }
    </script>
}