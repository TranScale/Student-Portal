@model IEnumerable<StudentPortal.Models.CourseMaterial>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 45%;">Tên tài liệu</th>
                    <th style="width: 20%;">Ngày đăng</th>
                    <th style="width: 10%;">Size</th>
                    <th style="width: 20%;" class="text-center">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var item in Model)
                {
                    // Logic xác định icon dựa trên đuôi file trong FileUrl
                    var extension = System.IO.Path.GetExtension(item.FileUrl)?.ToLower() ?? "";
                    var iconClass = "fa-file-o"; // Mặc định

                    if (extension.Contains("pdf")) { iconClass = "fa-file-pdf-o text-danger"; }
                    else if (extension.Contains("doc")) { iconClass = "fa-file-word-o text-primary"; }
                    else if (extension.Contains("xls")) { iconClass = "fa-file-excel-o text-success"; }
                    else if (extension.Contains("ppt")) { iconClass = "fa-file-powerpoint-o text-warning"; }
                    else if (extension.Contains("zip") || extension.Contains("rar")) { iconClass = "fa-file-archive-o text-warning"; }

                    <tr>
                        <td>@i</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <i class="fa @iconClass fa-lg mr-3"></i>
                                <span class="font-weight-bold">@item.Title</span>
                            </div>
                        </td>
                        <td>@item.CreationDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.FileSize MB</td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-light btn-action mr-1"
                                    data-title="@item.Title"
                                    data-date="@item.CreationDate.ToString("dd/MM/yyyy HH:mm")"
                                    data-url="@item.FileUrl"
                                    data-size="@item.FileSize"
                                    onclick="showMaterialModal(this)">
                                <i class="fa fa-info-circle"></i> Chi tiết
                            </button>

                            <a href="@item.FileUrl" download target="_blank" class="btn btn-sm btn-light btn-action text-dark">
                                <i class="fa fa-download"></i>
                            </a>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-white mt-5">
        <i class="fa fa-folder-open-o fa-3x mb-3 text-white-50"></i>
        <h5 class="text-white-50">Chưa có tài liệu nào được đăng.</h5>
    </div>
}