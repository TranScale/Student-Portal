@model IEnumerable<StudentPortal.Models.CourseMaterial>

@{
    ViewData["Title"] = "Quản lý tài liệu - " + ViewData["CourseName"];
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    var sectionId = ViewData["SectionId"];
}

<style>
    /* Style riêng cho bảng quản lý */
    .table-glass {
        color: white !important;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        overflow: hidden;
    }

        .table-glass thead th {
            background-color: rgba(0, 0, 0, 0.2);
            color: #fff;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .table-glass tbody td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-glass tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

    /* Các nút hành động nhỏ */
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-right: 5px;
        transition: all 0.2s;
    }

        .btn-icon:hover {
            transform: scale(1.1);
        }

    /* Toolbar kính mờ */
    .toolbar-glass {
        background: rgba(0, 0, 0, 0.25);
        border-radius: 8px;
        padding: 15px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>

<div class="container-fluid mt-3">
    <a href="@Url.Action("LecturerIndex", "CourseMaterials")" class="text-white-50 mb-3 d-inline-block hover-highlight" style="text-decoration: none;">
        <i class="fa fa-arrow-left mr-2"></i> Quay lại danh sách lớp
    </a>

    <div class="row">
        <div class="col-12">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                <div class="mb-3 mb-md-0">
                    <h3 class="text-white font-weight-bold">@ViewData["CourseName"]</h3>
                </div>

                <div class="toolbar-glass d-flex align-items-center">

                    <div class="position-relative mr-3">
                        <i class="fa fa-search text-white-50" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%);"></i>
                        <input type="text" id="ajaxSearchInput"
                               class="form-control border-0 text-white"
                               style="background: rgba(255,255,255,0.15); padding-left: 35px; width: 250px;"
                               placeholder="Tìm tên tài liệu..." autocomplete="off">
                    </div>

                    <button class="btn btn-success font-weight-bold shadow-sm" data-toggle="modal" data-target="#uploadModal">
                        <i class="fa fa-cloud-upload mr-2"></i> Tải lên
                    </button>
                </div>
            </div>

            <div id="tableContainer">
                <partial name="_LecturerMaterialTable" model="Model" />
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title font-weight-bold"><i class="fa fa-upload mr-2"></i> Tải lên tài liệu mới</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="UploadMaterial" asp-controller="CourseMaterials" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="sectionId" value="@sectionId" />

                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Chọn tập tin</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" name="file" id="customFile" required>
                            <label class="custom-file-label" for="customFile">Chọn file...</label>
                        </div>
                        <small class="text-muted">Hỗ trợ: PDF, Word, Excel, PPT, Zip (Max: 20MB)</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-dark">Tiêu đề hiển thị (Tùy chọn)</label>
                        <input type="text" name="displayTitle" class="form-control" placeholder="Nhập tên hiển thị cho sinh viên...">
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Xác nhận tải lên</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-dark">
                Bạn có chắc chắn muốn xóa tài liệu <b id="deleteFileName"></b> không?
                <br />Hành động này không thể hoàn tác.
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteMaterial" method="post">
                    <input type="hidden" name="id" id="deleteFileId" />
                    <input type="hidden" name="sectionId" value="@sectionId" /> <button type="button" class="btn btn-light" data-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // 1. Script cho ô input file hiển thị tên
    $(".custom-file-input").on("change", function() {
        var fileName = $(this).val().split("\\").pop();
        $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
    });

    // 2. Script gán dữ liệu cho Modal Xóa
    function confirmDelete(id, name) {
        $('#deleteFileId').val(id);
        $('#deleteFileName').text(name);
        $('#deleteModal').modal('show');
    }

    // 3. Script AJAX Search (Giống Student nhưng trỏ về partial của Lecturer)
        // 3. Script AJAX Search - Gõ đến đâu tìm đến đó
    $(document).ready(function () {
        const $input = $('#ajaxSearchInput');
        const $container = $('#tableContainer');
        const sectionId = '@ViewData["SectionId"]';

        // Sự kiện 'input' sẽ bắt thay đổi ngay lập tức khi gõ phím
        $input.on('input', function () {
            var searchText = $(this).val();

            $.ajax({
                // SỬA TẠI ĐÂY: Trỏ về CourseMaterials thay vì Lecturers
                url: '@Url.Action("GetMaterialsTable", "CourseMaterials")',
                type: 'GET',
                data: { sectionId: sectionId, searchString: searchText },
                beforeSend: function() {
                    // Hiệu ứng mờ nhẹ để người dùng biết đang load
                    $container.stop().fadeTo(100, 0.6);
                },
                success: function (result) {
                    $container.stop().fadeTo(100, 1).html(result);
                },
                error: function (xhr) {
                    console.error("Lỗi tìm kiếm:", xhr.responseText);
                    $container.stop().fadeTo(100, 1);
                }
            });
        });
    });
</script>