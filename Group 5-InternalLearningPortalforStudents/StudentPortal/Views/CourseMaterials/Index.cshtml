@model IEnumerable<StudentPortal.Models.CourseMaterial>

@{
    ViewData["Title"] = "Tài liệu môn học";
    int sectionId = ViewBag.SectionId != null ? (int)ViewBag.SectionId : 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📚 Tài liệu môn học</h2>
        @if (User.IsInRole("Lecturer"))
        {
            <a asp-action="Upload" asp-route-sectionId="@sectionId" class="btn btn-primary">
                <i class="bi bi-cloud-upload"></i> Upload tài liệu mới
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Chưa có tài liệu nào.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên tài liệu</th>
                            <th>Ngày đăng</th>
                            <th>Dung lượng</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.Title</td>
                                <td class="align-middle">@item.CreationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="align-middle">@item.FileSize.ToString("0.00") MB</td>
                                <td class="align-middle text-center">
                                    <a asp-action="Download" asp-route-id="@item.CourseMaterialId" class="btn btn-sm btn-outline-success me-2">
                                        📥 Tải về
                                    </a>

                                    @if (User.IsInRole("Lecturer"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.CourseMaterialId" method="post" class="d-inline" onsubmit="return confirm('Xóa file này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-secondary">Quay lại</a>
    </div>
</div>