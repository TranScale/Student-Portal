@model IEnumerable<StudentPortal.Models.Semester>

@{
    ViewData["Title"] = "Quản lý Học kỳ";
    Layout = "_AdminLayout";
}

<style>
    /* Nút kích hoạt (khi chưa active) */
    .btn-set-active {
        color: #adb5bd;
        border: 1px solid rgba(255,255,255,0.2);
        transition: all 0.2s;
    }

        .btn-set-active:hover {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

    /* Dòng đang được kích hoạt */
    .row-active {
        background-color: rgba(40, 167, 69, 0.1) !important; /* Màu xanh lá nhạt trong suốt */
    }

    /* Badge hiển thị năm học */
    .badge-year {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-weight: normal;
        border: 1px solid rgba(255,255,255,0.2);
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #fff;">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Quản lý Học kỳ</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus mr-2"></i>Thêm Học kỳ
    </a>
</div>

<div class="glass-panel">
    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Tên học kỳ</th>
                    <th>Năm học</th>
                    <th>Thời gian</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "row-active" : "")">

                        <td>
                            <span class="badge badge-info p-2" style="font-size: 0.9rem;">
                                @item.SemesterName
                            </span>
                        </td>

                        <td>
                            <span class="badge badge-year p-2">@item.AcademicYear</span>
                        </td>

                        <td>
                            <div class="text-white small">
                                <i class="fas fa-calendar-alt mr-2 text-muted"></i>
                                @item.StartDate.ToString("dd/MM/yyyy")
                                <span class="text-muted mx-1">&rarr;</span>
                                @item.EndDate.ToString("dd/MM/yyyy")
                            </div>
                        </td>

                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success p-2">
                                    <i class="fas fa-check-circle mr-1"></i> Đang diễn ra
                                </span>
                            }
                            else
                            {
                                <form asp-action="SetCurrent" asp-route-id="@item.SemesterId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-set-active rounded-pill px-3"
                                            title="Kích hoạt học kỳ này"
                                            onclick="return confirm('Bạn có chắc muốn thiết lập @item.SemesterName làm học kỳ hiện tại?');">
                                        <i class="fas fa-sync-alt mr-1"></i> Thiết lập
                                    </button>
                                </form>
                            }
                        </td>

                        <td class="text-right">
                            <a asp-action="Details" asp-route-id="@item.SemesterId" class="btn btn-sm btn-outline-info btn-icon" title="Xem chi tiết">
                                <i class="fas fa-info"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.SemesterId" class="btn btn-sm btn-outline-light btn-icon" title="Sửa">
                                <i class="fas fa-pen"></i>
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-danger btn-icon"
                                    data-toggle="modal" data-target="#deleteModal"
                                    onclick="setDeleteId('@item.SemesterId', '@item.SemesterName')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white; border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa học kỳ <strong id="deleteNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Cảnh báo: Dữ liệu liên quan đến học phần trong kỳ này có thể bị ảnh hưởng.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Semesters/Delete/" + id;
        document.getElementById("deleteNameDisplay").innerText = name;
    }
</script>