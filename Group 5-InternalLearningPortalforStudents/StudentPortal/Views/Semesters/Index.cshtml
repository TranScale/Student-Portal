@using StudentPortal.Models
@model PaginatedList<StudentPortal.Models.Semester>

@{
    ViewData["Title"] = "Quản lý Học kỳ";
    Layout = "_AdminLayout";
}

<style>
    /* Nút kích hoạt (khi chưa active - màu xám) */
    .btn-set-inactive {
        color: #adb5bd;
        border: 1px solid rgba(255,255,255,0.2);
        background: transparent;
        transition: all 0.2s;
    }

        .btn-set-inactive:hover {
            background-color: #0d6efd; /* Hover thành màu xanh dương */
            color: white;
            border-color: #0d6efd;
        }

    /* Nút đang kích hoạt (màu xanh lá) */
    .btn-set-active {
        background-color: rgba(40, 167, 69, 0.8);
        color: white;
        border: 1px solid #28a745;
        transition: all 0.2s;
    }

        .btn-set-active:hover {
            background-color: #dc3545; /* Hover thành màu đỏ để báo hiệu tắt */
            border-color: #dc3545;
        }

            /* Khi hover vào nút đang active, đổi icon và text (dùng CSS trick hoặc JS, ở đây dùng simple CSS hover effect opacity) */
            .btn-set-active:hover i {
                /* Có thể custom thêm nếu muốn */
            }

    /* Dòng đang được kích hoạt */
    .row-active {
        background-color: rgba(40, 167, 69, 0.15) !important;
    }

    /* Badge hiển thị năm học */
    .badge-year {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-weight: normal;
        border: 1px solid rgba(255,255,255,0.2);
    }

    /* Style cho Dropdown lọc */
    .filter-select {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }

        .filter-select option {
            background-color: #1e2130;
            color: white;
        }

        .filter-select:focus {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
            border-color: #0d6efd;
            box-shadow: none;
        }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background: rgba(40, 167, 69, 0.2); border: 1px solid #28a745; color: #fff;">
        <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-info-circle mr-2"></i> @TempData["InfoMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-weight-bold text-white mb-0">Quản lý Học kỳ</h2>
    <a asp-action="Create" class="btn btn-light text-primary font-weight-bold shadow-sm">
        <i class="fas fa-plus mr-2"></i>Thêm Học Kỳ
    </a>
</div>

<div class="glass-panel mb-4 p-3 mt-3">
    <form asp-action="Index" method="get">
        <div class="row align-items-end">
            <div class="col-md-4 mb-2">
                <label class="text-white small font-weight-bold">Lọc theo Năm học</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent text-white border-secondary">
                            <i class="fas fa-filter"></i>
                        </span>
                    </div>
                    <select name="academicYear" class="form-control filter-select" asp-items="ViewBag.AcademicYears" onchange="this.form.submit()">
                        <option value="">-- Tất cả năm học --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-2 mb-2">
                <a asp-action="Index" class="btn btn-outline-light btn-block">
                    <i class="fas fa-sync-alt mr-1"></i> Làm mới
                </a>
            </div>
        </div>
    </form>
</div>

<div class="glass-panel">
    <div class="table-responsive">
        <table class="table-admin">
            <thead>
                <tr>
                    <th>Tên học kỳ</th>
                    <th>Năm học</th>
                    <th>Thời gian</th>
                    <th class="text-center" style="width: 180px;">Trạng thái</th>
                    <th class="text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-white-50">
                            Không tìm thấy dữ liệu phù hợp.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "row-active" : "")">

                        <td>
                            <span class="badge badge-info p-2 text-white" style="font-size: 0.9rem;">
                                @item.SemesterName
                            </span>
                        </td>

                        <td>
                            <span class="badge badge-year p-2">@item.AcademicYear</span>
                        </td>

                        <td>
                            <div class="text-white small">
                                <i class="fas fa-calendar-alt mr-2 text-muted"></i>
                                @item.StartDate.ToString("dd/MM/yyyy")
                                <span class="text-muted mx-1">&rarr;</span>
                                @item.EndDate.ToString("dd/MM/yyyy")
                            </div>
                        </td>

                        <td class="text-center">
                            <form asp-action="ToggleStatus" asp-route-id="@item.SemesterId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()

                                @if (item.IsActive)
                                {
                                    @* TRẠNG THÁI ON: Hiện nút Xanh -> Bấm để Tắt *@
                                    <button type="submit" class="btn btn-sm btn-set-active rounded-pill px-3 shadow-sm"
                                            title="Đang hoạt động. Nhấn để tắt."
                                            onclick="return confirm('Bạn có muốn TẮT trạng thái hoạt động của @item.SemesterName?');">
                                        <i class="fas fa-check-circle mr-1"></i> Đang diễn ra
                                    </button>
                                }
                                else
                                {
                                    @* TRẠNG THÁI OFF: Hiện nút Xám -> Bấm để Bật *@
                                    <button type="submit" class="btn btn-sm btn-set-inactive rounded-pill px-3"
                                            title="Học kỳ đang đóng. Nhấn để kích hoạt."
                                            onclick="return confirm('Bạn có muốn KÍCH HOẠT @item.SemesterName?');">
                                        <i class="fas fa-power-off mr-1"></i> Kích hoạt
                                    </button>
                                }
                            </form>
                        </td>

                        <td class="text-right">
                            @* 1. Nút Chi tiết *@
                            <a asp-action="Details" asp-route-id="@item.SemesterId" class="btn btn-sm btn-outline-primary rounded-circle mr-1" title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>

                            @* 2. Nút Sửa *@
                            <a asp-action="Edit" asp-route-id="@item.SemesterId" class="btn btn-sm btn-outline-info rounded-circle mr-1" title="Sửa">
                                <i class="fas fa-pen"></i>
                            </a>

                            @* 3. [MỚI] Nút KẾT THÚC HỌC KỲ (Chỉ hiện khi đang Active) *@
                            @if (item.IsActive)
                            {
                                <form asp-action="Finish" asp-route-id="@item.SemesterId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-warning rounded-circle mr-1"
                                            title="Kết thúc học kỳ & Chốt trạng thái SV"
                                            onclick="return confirm('⚠️ CẢNH BÁO QUAN TRỌNG:\n\nBạn đang thực hiện KẾT THÚC học kỳ @item.SemesterName.\n\nHành động này sẽ:\n1. Tắt trạng thái hoạt động (Active -> Inactive).\n2. Chuyển TẤT CẢ sinh viên đang học (Approved) sang trạng thái ĐÃ HỌC (Finished).\n\nBạn có chắc chắn muốn tiếp tục không?');">
                                        <i class="fas fa-flag-checkered"></i>
                                    </button>
                                </form>
                            }

                            @* 4. Nút Xóa *@
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle"
                                    data-toggle="modal" data-target="#deleteModal"
                                    onclick="setDeleteId('@item.SemesterId', '@item.SemesterName')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
            <div class="text-white-50 small">
                Trang @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) / @Model.TotalPages
            </div>
            <div>
                @{
                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                }
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   asp-route-academicYear="@ViewData["CurrentYear"]"
                   class="btn btn-sm btn-outline-light @prevDisabled">
                    <i class="fas fa-chevron-left mr-1"></i> Trước
                </a>
                <a asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                   asp-route-academicYear="@ViewData["CurrentYear"]"
                   class="btn btn-sm btn-outline-light ml-2 @nextDisabled">
                    Sau <i class="fas fa-chevron-right ml-1"></i>
                </a>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: #1e2130; color: white; border: 1px solid rgba(255,255,255,0.1);">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa học kỳ <strong id="deleteNameDisplay" class="text-warning"></strong>?<br>
                <small class="text-muted">Cảnh báo: Dữ liệu liên quan đến học phần trong kỳ này có thể bị ảnh hưởng.</small>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteId(id, name) {
        document.getElementById("deleteForm").action = "/Semesters/Delete/" + id;
        document.getElementById("deleteNameDisplay").innerText = name;
    }
</script>