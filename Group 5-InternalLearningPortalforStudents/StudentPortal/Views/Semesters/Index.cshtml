@model IEnumerable<StudentPortal.Models.Semester>

@{
    ViewData["Title"] = "Quản lý Học kỳ";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white">Quản lý Học kỳ</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus mr-2"></i>Thêm học kỳ mới
    </a>
</div>

<div class="card shadow" style="background-color: #1e2130; border: none;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table text-white mb-0">
                <thead style="background-color: rgba(255,255,255,0.05);">
                    <tr>
                        <th class="pl-4 border-top-0">Tên học kỳ</th>
                        <th class="border-top-0">Năm học</th>
                        <th class="border-top-0">Thời gian</th>
                        <th class="border-top-0 text-center">Trạng thái</th>
                        <th class="border-top-0 text-right pr-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var rowClass = item.IsActive ? "bg-primary-soft" : "";
                        var rowStyle = item.IsActive ? "background-color: rgba(78, 115, 223, 0.1);" : "";

                        <tr style="@rowStyle">
                            <td class="pl-4 align-middle border-top-0" style="border-color: rgba(255,255,255,0.05);">
                                <span class="font-weight-bold">@item.SemesterName</span>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success ml-2">Đang diễn ra</span>
                                }
                            </td>
                            <td class="align-middle border-top-0" style="border-color: rgba(255,255,255,0.05);">
                                @item.AcademicYear
                            </td>
                            <td class="align-middle border-top-0" style="border-color: rgba(255,255,255,0.05);">
                                <small class="d-block text-muted">Bắt đầu: @item.StartDate.ToString("dd/MM/yyyy")</small>
                                <small class="d-block text-muted">Kết thúc: @item.EndDate.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td class="align-middle text-center border-top-0" style="border-color: rgba(255,255,255,0.05);">
                                @if (!item.IsActive)
                                {
                                    <form asp-action="SetCurrent" asp-route-id="@item.SemesterId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-light" onclick="return confirm('Bạn có chắc muốn kích hoạt học kỳ này làm học kỳ hiện tại? Các học kỳ khác sẽ bị tắt.');">
                                            <i class="far fa-check-circle mr-1"></i> Thiết lập
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-success"><i class="fas fa-check-circle fa-lg"></i></span>
                                }
                            </td>
                            <td class="align-middle text-right pr-4 border-top-0" style="border-color: rgba(255,255,255,0.05);">
                                <a asp-action="Edit" asp-route-id="@item.SemesterId" class="btn btn-sm btn-warning">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.SemesterId" class="btn btn-sm btn-info ml-1">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>