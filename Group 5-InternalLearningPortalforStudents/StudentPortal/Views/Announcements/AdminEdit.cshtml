@model StudentPortal.Models.Announcement

@{
    ViewData["Title"] = "Chỉnh sửa Thông báo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-panel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="panel-title mb-0">Chỉnh sửa Thông báo</h3>
                    <small class="text-white-50 text-right">
                        Ngày tạo: <span class="text-warning">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span><br />
                        Người đăng: <span class="text-info">@(Model.User?.FullName ?? "Admin")</span>
                    </small>
                </div>

                <form asp-action="AdminEdit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="AnnouncementId" />

                    <div class="form-group">
                        <label asp-for="Title" class="text-white"></label>
                        <input asp-for="Title" class="form-control bg-dark text-white border-secondary" placeholder="Nhập tiêu đề..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Summary" class="text-white"></label>
                        <textarea asp-for="Summary" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Tóm tắt ngắn gọn..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Taker" class="text-white"></label>
                                <select asp-for="Taker" class="form-control bg-dark text-white border-secondary"
                                        asp-items="Html.GetEnumSelectList<StudentPortal.Models.RecipientType>()">
                                </select>
                                <span asp-validation-for="Taker" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ExpiredDate" class="text-white"></label>
                                <input asp-for="ExpiredDate" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="ExpiredDate" class="text-danger"></span>
                                <small class="form-text text-muted">Để trống nếu không có thời hạn.</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Content" class="text-white"></label>
                        <textarea asp-for="Content" class="form-control bg-dark text-white border-secondary" rows="10" placeholder="Nội dung chi tiết..."></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">
                            <i class="fas fa-arrow-left mr-2"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success px-4 shadow">
                            <i class="fas fa-save mr-2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}