@model StudentPortal.Models.PaginatedList<StudentPortal.Models.Announcement>
@using Microsoft.AspNetCore.Identity
@inject UserManager<StudentPortal.Models.User> UserManager
@{
    ViewData["Title"] = "Bảng tin thông báo";
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
    var currentUserId = UserManager.GetUserId(User);
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card bg-transparent border-0">
                <div class="card-body p-0">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-white m-0">
                            <i class="zmdi zmdi-notifications-active"></i> Bảng tin Giảng viên
                        </h5>

                        <div class="d-flex align-items-center">
                            <div class="search-wrapper mr-2" style="width: 300px;">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-light text-white">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" id="ajaxSearchInput" value="@ViewData["CurrentFilter"]"
                                           class="form-control bg-transparent border-light text-white"
                                           placeholder="Tìm kiếm thông báo..." autocomplete="off">
                                </div>
                            </div>

                            <button id="btnFilterMy" onclick="toggleMyFilter()"
                                    class="btn btn-glass-custom font-weight-bold ml-2"
                                    style="height: 38px; min-width: 110px;">
                                <i id="iconFilterMy" class="fa fa-square-o mr-2" style="font-size: 1.2rem;"></i>
                                <span>CỦA TÔI</span>
                            </button>

                            <button onclick="openCreateModal()"
                                    class="btn btn-glass-custom font-weight-bold ml-2"
                                    style="height: 38px; min-width: 120px;">
                                <i class="fa fa-plus-circle mr-2" style="font-size: 1.2rem;"></i>
                                <span>THÊM MỚI</span>
                            </button>
                        </div>
                    </div>

                    <div id="tableContainer">
                        <partial name="_AnnouncementTable" model="Model" />
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">Chi tiết thông báo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-white text-dark">
                <div class="form-group row border-bottom pb-2">
                    <label class="col-sm-2 col-form-label text-muted font-weight-bold">Người gửi:</label>
                    <div class="col-sm-10 d-flex align-items-center justify-content-between">
                        <span id="popupUser" class="font-weight-bold text-primary"></span>
                        <small id="popupDate" class="text-muted"></small>
                    </div>
                </div>
                <div class="form-group row border-bottom pb-2">
                    <label class="col-sm-2 col-form-label text-muted font-weight-bold">Tiêu đề:</label>
                    <div class="col-sm-10">
                        <input type="text" readonly class="form-control-plaintext font-weight-bold text-dark" id="popupTitle">
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label class="text-muted font-weight-bold mb-2">Nội dung chi tiết:</label>
                    <div class="p-3 bg-light rounded border" style="min-height: 200px;">
                        <div id="popupContent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <input type="hidden" id="popupIdHidden">

                <button type="button" id="btnModalDelete" onclick="deleteFromModal()"
                        class="btn btn-outline-danger border-0 font-weight-bold"
                        style="display: none;">
                    <i class="fa fa-trash"></i> Xóa bài này
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">Đăng thông báo mới</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-white text-dark">
                <div id="createModalContent">
                    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .custom-table {
        color: white !important;
    }

        .custom-table thead th {
            color: #e0e0e0;
            font-weight: 600;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
            vertical-align: middle;
        }

        .custom-table tbody td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            vertical-align: middle;
        }

        /* Hiệu ứng hover dòng */
        .custom-table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.15) !important;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.6) !important;
    }

    /* =========================================
           2. THANH TÌM KIẾM (SEARCH INPUT)
           ========================================= */
    #ajaxSearchInput::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    #ajaxSearchInput {
        transition: all 0.3s ease;
    }

        #ajaxSearchInput:focus {
            background-color: rgba(255, 255, 255, 0.2) !important; /* Đậm hơn chút khi focus */
            color: white;
            box-shadow: none;
            border-color: rgba(255, 255, 255, 0.5) !important;
        }

    /* Icon kính lúp */
    .search-wrapper .input-group-text {
        border-color: rgba(255, 255, 255, 0.2) !important; /* Khớp với viền input */
    }

    /* =========================================
           3. NÚT LỌC "CỦA TÔI" (QUAN TRỌNG MỚI THÊM)
           ========================================= */
    .btn-glass-custom {
        background-color: rgba(255, 255, 255, 0.1) !important; /* Nền trong suốt 10% */
        backdrop-filter: blur(5px); /* Hiệu ứng làm mờ nền sau lưng */
        -webkit-backdrop-filter: blur(5px); /* Hỗ trợ Safari */
        border: 1px solid rgba(255, 255, 255, 0.3) !important; /* Viền mỏng sáng */
        color: white !important; /* Chữ trắng */
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        /* Khi di chuột vào */
        .btn-glass-custom:hover {
            background-color: rgba(255, 255, 255, 0.2) !important; /* Sáng hơn chút */
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

    /* Khi ĐANG CHỌN (Active) - Sẽ phát sáng viền */
    .btn-glass-active {
        background-color: rgba(255, 255, 255, 0.25) !important;
        border-color: #fff !important; /* Viền trắng rõ hơn */
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.4); /* Hiệu ứng tỏa sáng neon */
        text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
    }

    /* =========================================
           4. MODAL (POPUP)
           ========================================= */
    /* Đảm bảo chữ trong modal luôn màu tối dễ đọc trên nền trắng */
    #createModal, #detailModal {
        color: #333;
    }

        /* Label trong modal */
        #createModal label, #detailModal label {
            color: #333 !important;
            font-weight: 600;
        }

        /* Các ô input trong modal (ghi đè style tối của layout chính) */
        #createModal .form-control,
        #detailModal .form-control {
            color: #333 !important;
            background-color: #fff !important;
            border: 1px solid #ced4da !important;
        }

            #createModal .form-control:focus {
                border-color: #80bdff !important;
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            }

        /* Khoảng cách giữa các dòng trong form */
        #createModal .form-group {
            margin-bottom: 1.5rem;
        }

    /* =========================================
           5. PHÂN TRANG (PAGINATION - NẾU CÓ)
           ========================================= */
    /* Chỉnh màu nút phân trang cho hợp nền tối */
    .pagination .page-link {
        background-color: transparent;
        border-color: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .pagination .page-item.active .page-link {
        background-color: rgba(255, 255, 255, 0.3); /* Nền sáng hơn cho trang hiện tại */
        border-color: transparent;
        color: white;
        font-weight: bold;
    }

    .pagination .page-item.disabled .page-link {
        background-color: transparent;
        color: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.1);
    }

    .pagination .page-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // --- 1. KHAI BÁO BIẾN ---
    let isMyFilterActive = false;
    let typingTimer;
    const doneTypingInterval = 500;

    const myCurrentUserId = '@currentUserId';

    $(document).ready(function () {
        const $input = $('#ajaxSearchInput');

        // Logic tìm kiếm khi gõ phím
        $input.on('keyup', function () {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(loadData, doneTypingInterval);
        });
        $input.on('keydown', function () { clearTimeout(typingTimer); });
    });

    // --- 2. HÀM XỬ LÝ CLICK NÚT VUÔNG "CỦA TÔI" ---
    function toggleMyFilter() {
        isMyFilterActive = !isMyFilterActive;
        const btn = $('#btnFilterMy');
        const icon = $('#iconFilterMy');

        if (isMyFilterActive) {
            btn.addClass('btn-glass-active'); // Hiệu ứng sáng
            icon.removeClass('fa-square-o').addClass('fa-check-square');
        } else {
            btn.removeClass('btn-glass-active');
            icon.removeClass('fa-check-square').addClass('fa-square-o');
        }
        loadData();
    }

    // --- 3. HÀM GỌI SERVER (AJAX LOAD TABLE) ---
    function loadData() {
        var searchText = $('#ajaxSearchInput').val();
        var $container = $('#tableContainer');

        $.ajax({
            url: '@Url.Action("LecturerAnnouncement", "Announcements")',
            type: 'GET',
            data: {
                searchString: searchText,
                showMyOnly: isMyFilterActive
            },
            beforeSend: function(xhr) {
                xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
                $container.css("opacity", "0.5");
            },
            success: function (result) {
                $container.html(result);
                $container.css("opacity", "1");
            },
            error: function () {
                $container.css("opacity", "1");
            }
        });
    }

    // --- 4. HÀM MODAL TẠO MỚI ---
    function openCreateModal() {
        $('#createModalContent').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');
        $('#createModal').modal('show');
        $.ajax({
            url: '@Url.Action("Create", "Announcements")',
            type: 'GET',
            success: function (res) { $('#createModalContent').html(res); },
            error: function () { $('#createModalContent').html('<p class="text-danger text-center">Lỗi tải form!</p>'); }
        });
    }

    // Xử lý submit form tạo mới
    $(document).on('submit', '#createAnnouncementForm', function (e) {
        e.preventDefault();
        var form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                if (response.success) {
                    $('#createModal').modal('hide');
                    loadData(); // Load lại bảng
                } else {
                    $('#createModalContent').html(response);
                }
            },
            error: function () { alert('Có lỗi xảy ra khi lưu!'); }
        });
    });

    // --- 5. HÀM HIỆN CHI TIẾT (QUAN TRỌNG: CÓ NÚT XÓA) ---
    function showAnnouncementModal(element) {
        // Lấy data từ dòng click
        var id = element.getAttribute('data-id');
        var userId = element.getAttribute('data-userid'); // ID tác giả
        var title = element.getAttribute('data-title');
        var content = element.getAttribute('data-content');
        var date = element.getAttribute('data-date');
        var user = element.getAttribute('data-user');

        // Đổ dữ liệu vào Modal
        $('#popupIdHidden').val(id); // Lưu ID vào ô ẩn để dùng khi xóa
        $('#popupTitle').val(title);
        $('#popupUser').text(user);
        $('#popupDate').text(date);
        $('#popupContent').html(content);

        // LOGIC ẨN/HIỆN NÚT XÓA
        // So sánh ID tác giả (userId) với ID người đang đăng nhập (myCurrentUserId)
        // Chuyển về string để so sánh cho chắc ăn
        if (String(userId) === String(myCurrentUserId)) {
            $('#btnModalDelete').show(); // Hiện nút Xóa
        } else {
            $('#btnModalDelete').hide(); // Ẩn nút Xóa
        }

        $('#detailModal').modal('show');
    }

    // --- 6. HÀM XÓA BÀI TỪ MODAL ---
    function deleteFromModal() {
        var id = $('#popupIdHidden').val(); // Lấy ID từ ô ẩn

        if (confirm('Đại ca chắc chắn muốn xóa bài này không?')) {
            $.ajax({
                url: '@Url.Action("DeleteAjax", "Announcements")', // Gọi Action DeleteAjax đã tạo
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        $('#detailModal').modal('hide'); // Tắt modal
                        loadData(); // Load lại bảng để mất dòng đó đi
                        // alert(res.message); // Có thể bật lên nếu thích
                    } else {
                        alert(res.message); // Lỗi (ví dụ: không đúng quyền)
                    }
                },
                error: function () {
                    alert('Lỗi hệ thống, xóa không được rồi đại ca ơi.');
                }
            });
        }
    }
</script>