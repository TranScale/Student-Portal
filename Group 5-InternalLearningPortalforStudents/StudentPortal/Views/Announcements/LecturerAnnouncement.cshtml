@model StudentPortal.Models.PaginatedList<StudentPortal.Models.Announcement>

@{
    ViewData["Title"] = "Bảng tin thông báo";
    Layout = "~/Views/Shared/_LecturerLayout.cshtml";
}

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card bg-transparent border-0">
                <div class="card-body p-0">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-white m-0">
                            <i class="zmdi zmdi-notifications-active"></i> Bảng tin Giảng viên
                        </h5>

                        <div class="d-flex align-items-center">
                            <div class="search-wrapper mr-2" style="width: 300px;">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-light text-white">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" id="ajaxSearchInput" value="@ViewData["CurrentFilter"]"
                                           class="form-control bg-transparent border-light text-white"
                                           placeholder="Tìm kiếm thông báo..." autocomplete="off">
                                </div>
                            </div>

                            <button onclick="openCreateModal()" class="btn btn-light text-dark font-weight-bold ml-2" style="white-space: nowrap;">
                                <i class="fa fa-plus-circle"></i> Thêm mới
                            </button>
                        </div>
                    </div>

                    <div id="tableContainer">
                        <partial name="_AnnouncementTable" model="Model" />
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">Chi tiết thông báo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-white text-dark">
                <div class="form-group row border-bottom pb-2">
                    <label class="col-sm-2 col-form-label text-muted font-weight-bold">Người gửi:</label>
                    <div class="col-sm-10 d-flex align-items-center justify-content-between">
                        <span id="popupUser" class="font-weight-bold text-primary"></span>
                        <small id="popupDate" class="text-muted"></small>
                    </div>
                </div>
                <div class="form-group row border-bottom pb-2">
                    <label class="col-sm-2 col-form-label text-muted font-weight-bold">Tiêu đề:</label>
                    <div class="col-sm-10">
                        <input type="text" readonly class="form-control-plaintext font-weight-bold text-dark" id="popupTitle">
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label class="text-muted font-weight-bold mb-2">Nội dung chi tiết:</label>
                    <div class="p-3 bg-light rounded border" style="min-height: 200px;">
                        <div id="popupContent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold text-dark">Đăng thông báo mới</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-white text-dark">
                <div id="createModalContent">
                    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS cũ giữ nguyên */
    .custom-table {
        color: white !important;
    }

        .custom-table thead th {
            color: #e0e0e0;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .custom-table tbody td {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .custom-table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.15) !important;
            cursor: pointer;
        }

    #ajaxSearchInput::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    #ajaxSearchInput:focus {
        background-color: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.6) !important;
    }

    #createModal .form-control {
        color: #333 !important; 
        background-color: #fff !important; 
        border: 1px solid #ced4da !important; 
    }

    #createModal label {
        color: #333 !important; /* Nhãn (Label) màu đen */
        font-weight: 600;
    }

    #createModal .form-group {
        margin-bottom: 15px; /* Tách các dòng ra cho thoáng */
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // 1. Hàm hiển thị Modal Chi tiết (cũ)
    function showAnnouncementModal(element) {
        var title = element.getAttribute('data-title');
        var content = element.getAttribute('data-content');
        var date = element.getAttribute('data-date');
        var user = element.getAttribute('data-user');

        $('#popupTitle').val(title);
        $('#popupUser').text(user);
        $('#popupDate').text(date);
        $('#popupContent').html(content);

        $('#detailModal').modal('show');
    }

    // 2. Hàm hiển thị Modal Tạo mới (MỚI)
    function openCreateModal() {
        // Reset nội dung modal về trạng thái loading
        $('#createModalContent').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');
        $('#createModal').modal('show');

        // Gọi AJAX lấy form Create
        $.ajax({
            url: '@Url.Action("Create", "Announcements")',
            type: 'GET',
            success: function (res) {
                $('#createModalContent').html(res);
            },
            error: function () {
                $('#createModalContent').html('<p class="text-danger text-center">Lỗi tải form!</p>');
            }
        });
    }

    // 3. Xử lý Submit Form Tạo mới (MỚI)
    // Dùng $(document).on để bắt sự kiện cho form được load động
    $(document).on('submit', '#createAnnouncementForm', function (e) {
        e.preventDefault(); // Chặn reload trang

        var form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                if (response.success) {
                    // Thành công: Tắt modal, load lại trang để thấy bài mới
                    $('#createModal').modal('hide');
                    location.reload();
                    // Hoặc pro hơn thì gọi lại hàm search AJAX để cập nhật bảng mà ko reload
                } else {
                    // Thất bại (Validation): Hiện lại form có lỗi
                    $('#createModalContent').html(response);
                }
            },
            error: function () {
                alert('Có lỗi xảy ra khi lưu!');
            }
        });
    });

    // 4. Xử lý Tìm kiếm AJAX (Cũ - giữ nguyên)
    $(document).ready(function () {
        let typingTimer;
        const doneTypingInterval = 500;
        const $input = $('#ajaxSearchInput');
        const $container = $('#tableContainer');

        $input.on('keyup', function () {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(doneTyping, doneTypingInterval);
        });
        $input.on('keydown', function () { clearTimeout(typingTimer); });

        function doneTyping() {
            var searchText = $input.val();
            $.ajax({
                url: '@Url.Action("LecturerAnnouncement", "Announcements")',
                type: 'GET',
                data: { searchString: searchText },
                beforeSend: function(xhr) {
                    xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
                    $container.css("opacity", "0.5");
                },
                success: function (result) {
                    $container.html(result);
                    $container.css("opacity", "1");
                },
                error: function () {
                    console.log("Lỗi search");
                    $container.css("opacity", "1");
                }
            });
        }
    });
</script>