@using StudentPortal.Models
@model StudentPortal.Models.Announcement

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" id="createAnnouncementForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label text-dark font-weight-bold">Tiêu đề</label>
                <input asp-for="Title" class="form-control text-dark border border-secondary" style="color: black !important; background: white !important;" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Taker" class="control-label text-dark font-weight-bold">Người nhận</label>
                <select asp-for="Taker"
                        class="form-control text-dark border border-secondary"
                        style="color: black !important; background: white !important;"
                        asp-items="Html.GetEnumSelectList<RecipientType>()">
                </select>
                <span asp-validation-for="Taker" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Summary" class="control-label text-dark font-weight-bold">Tóm tắt</label>
                <textarea asp-for="Summary" class="form-control text-dark border border-secondary" rows="2" style="color: black !important; background: white !important;"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label text-dark font-weight-bold">Nội dung</label>
                <textarea asp-for="Content" class="form-control text-dark border border-secondary" rows="5" style="color: black !important; background: white !important;"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="CreatedDate" value="@DateTime.Now" />

            <div class="form-group text-right mt-4">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <input type="submit" value="Đăng thông báo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>