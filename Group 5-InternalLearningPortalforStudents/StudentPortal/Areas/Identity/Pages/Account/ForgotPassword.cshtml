@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    // Lưu ý: Layout này phải trỏ đúng file Layout Login/Public của bạn
    // Nếu bạn không dùng layout Admin cho trang này thì để null hoặc layout public
    Layout = null;
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<style>
    body { background: #1e2130; color: white; height: 100vh; display: flex; align-items: center; justify-content: center; }
    .glass-card { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border-radius: 15px; border: 1px solid rgba(255,255,255,0.1); }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card glass-card p-4 shadow-lg">
                <div class="text-center mb-4">
                    <h3 class="font-weight-bold text-white">Quên mật khẩu?</h3>
                    <p class="text-white-50">Đừng lo, hãy nhập email để lấy lại mật khẩu.</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <input asp-for="Input.Email" class="form-control bg-dark text-white border-secondary" placeholder="Nhập Email của bạn" style="height: 50px;" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold" style="background: linear-gradient(to right, #6a11cb, #2575fc); border: none;">
                        Gửi liên kết khôi phục
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-page="./Login" class="text-white-50 small">Quay lại Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}